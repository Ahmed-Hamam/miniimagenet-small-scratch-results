# 8. RESULT PRINTER
# ============================================

def print_resolution_sweep_table(results_1shot, results_5shot, flops_by_res):
    base_1shot = results_1shot[84][0]
    base_5shot = results_5shot[84][0]
    flops_224 = flops_by_res[224]

    print("\n" + "="*90)
    print("  RESOLUTION SWEEP — MobileNetV3-Small + Plain ProtoNet")
    print(f"  miniImageNet, 5-way 1-shot و5-shot. n=500 test episodes. BATCH_MODE={BATCH_MODE}")
    print("  batch size: " + ", ".join(f"{r}px={get_batch_size(r)}" for r in RESOLUTIONS))
    print("="*90)
    print(f"{'Resolution':<12} {'1-Shot (%)':>14} {'Δ1-shot':>10} "
          f"{'5-Shot (%)':>14} {'Δ5-shot':>10} {'GFLOPs':>10} {'FLOPs(rel)':>12} {'Gain/FLOPs':>12}")
    print("-"*90)

    for res in RESOLUTIONS:
        m1, ci1 = results_1shot[res]
        m5, ci5 = results_5shot[res]
        d1 = (m1 - base_1shot) * 100
        d5 = (m5 - base_5shot) * 100
        gflops = flops_by_res[res]
        flops_rel = gflops / flops_224
        eff = d1 / flops_rel if d1 > 0 else 0.0

        marker = " ◄ ImageNet native" if res == 224 else ""
        print(f"{res}×{res:<8} "
              f"{m1*100:>8.2f}±{ci1*100:.2f}  "
              f"{d1:>+9.2f}%  "
              f"{m5*100:>8.2f}±{ci5*100:.2f}  "
              f"{d5:>+9.2f}%  "
              f"{gflops:>8.4f}  "
              f"{flops_rel:>10.3f}x  "
              f"{eff:>10.2f}{marker}")
    print("="*90)

    accs = [results_1shot[r][0] for r in RESOLUTIONS]
    gains = [accs[i+1] - accs[i] for i in range(len(accs)-1)]
    max_gain_idx = int(np.argmax(gains))
    print(f"\n  Inflection point analysis (largest single-step 1-shot gain):")
    print(f"    {RESOLUTIONS[max_gain_idx]}×{RESOLUTIONS[max_gain_idx]} → "
          f"{RESOLUTIONS[max_gain_idx+1]}×{RESOLUTIONS[max_gain_idx+1]}: "
          f"+{gains[max_gain_idx]*100:.2f}pp")

    idx_224, idx_256 = RESOLUTIONS.index(224), RESOLUTIONS.index(256)
    delta_224_256 = (accs[idx_256] - accs[idx_224]) * 100
    print(f"\n  Above-224 marginal gain (224 → 256): {delta_224_256:+.2f}pp")
    if delta_224_256 < 0:
        print("  → Accuracy regresses above 224 — confirms 224 as saturation point.")
    elif delta_224_256 < 0.5:
        print("  → Negligible gain above 224 — confirms 224 as effective inflection.")
    else:
        print("  → Some gain above 224 — resolution effect not fully saturated.")

    print(f"\n  Efficiency analysis (1-shot gain relative to FLOPs cost):")
    for res in RESOLUTIONS[1:]:
        m1, _ = results_1shot[res]
        d1 = (m1 - base_1shot) * 100
        flops_rel = flops_by_res[res] / flops_224
        eff = d1 / flops_rel if flops_rel > 0 else 0.0
        print(f"    {res}×{res}: +{d1:.2f}pp accuracy at {flops_rel:.3f}x FLOPs → "
              f"{eff:.2f} pp/FLOPs-unit")
    print("="*90)

# ============================================
# 8b. RESUME / PROGRESS TRACKING
# ============================================
# ملف تقدّم بيتحدّث بعد كل (resolution, k_shot) يخلص — لو الجلسة اتقفلت
# (انقطع النت، خلصت ساعات Kaggle، ...) وشغّلت السكريبت تاني، هيقرأ الملف
# ده ويكمّل من عند آخر حاجة خلصها، من غير ما يعيد أي تدريب أو تقييم
# اتعمل قبل كده.

PROGRESS_FILE = os.path.join(WORK_ROOT, f"resolution_sweep_progress_{RUN_TAG}.json")


def load_progress():
    """يرجّع (results_1shot, results_5shot, flops_by_res) من ملف التقدّم
    لو موجود، وإلا قواميس فاضية."""
    if not os.path.exists(PROGRESS_FILE):
        return {}, {}, {}
    try:
        with open(PROGRESS_FILE, "r") as f:
            data = json.load(f)
    except (json.JSONDecodeError, OSError) as e:
        print(f"⚠️  ملف التقدّم {PROGRESS_FILE} تالف ({e}) — هنبدأ من الصفر.")
        return {}, {}, {}

    results_1shot = {int(r): (v["mean"], v["ci95"]) for r, v in data.get("1shot", {}).items()}
    results_5shot = {int(r): (v["mean"], v["ci95"]) for r, v in data.get("5shot", {}).items()}
    flops_by_res  = {int(r): v for r, v in data.get("gflops", {}).items()}

    if results_1shot or results_5shot:
        print(f"\n♻️  لقينا تقدّم سابق في {PROGRESS_FILE}:")
        print(f"    1-shot خلّصت لدقات: {sorted(results_1shot.keys())}")
        print(f"    5-shot خلّصت لدقات: {sorted(results_5shot.keys())}")

    return results_1shot, results_5shot, flops_by_res


def save_progress(results_1shot, results_5shot, flops_by_res):
    """يحفظ التقدّم الحالي بطريقة atomic (كتابة لملف مؤقت ثم rename) عشان
    لو الجلسة اتقفلت في نص الكتابة، الملف الأصلي يفضل سليم."""
    report = {
        "1shot": {str(r): {"mean": float(v[0]), "ci95": float(v[1])}
                  for r, v in results_1shot.items()},
        "5shot": {str(r): {"mean": float(v[0]), "ci95": float(v[1])}
                  for r, v in results_5shot.items()},
        "gflops": {str(r): float(f) for r, f in flops_by_res.items()},
    }
    tmp_path = PROGRESS_FILE + ".tmp"
    with open(tmp_path, "w") as f:
        json.dump(report, f, indent=2)
    os.replace(tmp_path, PROGRESS_FILE)  # rename ذرّي — إما ينجح كامل أو مايحصلش خالص

# ============================================
# 9. MAIN SWEEP RUNNER
# ============================================

def run_resolution(resolution, k_shot, episodes=1000, num_classes=64):
    s1_path = os.path.join(WORK_ROOT, f"sweep_backbone_{RUN_TAG}_{resolution}.pth")
    s2_path = os.path.join(WORK_ROOT, f"sweep_best_{RUN_TAG}_{resolution}_{k_shot}shot.pth")

    if not os.path.exists(s1_path):
        with StageTimer(f"Stage 1: Fine-Tuning ({resolution}px)"):
            stage1_finetuning(resolution, s1_path, epochs=10, num_classes=num_classes)
    else:
        try:
            torch.load(s1_path, map_location="cpu")
            print(f"✅ Stage 1 checkpoint found: {s1_path} — skipping.")
        except RuntimeError:
            print(f"⚠️  Corrupted checkpoint at {s1_path}. Deleting and regenerating...")
            os.remove(s1_path)
            with StageTimer(f"Stage 1: Fine-Tuning ({resolution}px)"):
                stage1_finetuning(resolution, s1_path, epochs=10, num_classes=num_classes)

    if not os.path.exists(s2_path):
        with StageTimer(f"Stage 2: Meta-Training {k_shot}-shot ({resolution}px)"):
            stage2_metatrain(resolution, s1_path, n_way=5, k_shot=k_shot,
                              episodes=episodes, num_classes=num_classes, save_path=s2_path)
    else:
        print(f"✅ Stage 2 checkpoint found: {s2_path} — skipping.")

    with StageTimer(f"Stage 3: Test Evaluation {k_shot}-shot ({resolution}px)"):
        _, test_transform = build_transforms(resolution)
        test_sampler = EpisodicSampler(os.path.join(MINI_ROOT, "test"), test_transform)
        model = load_model_for_eval(s2_path, num_classes=num_classes)
        print(f"\n   Evaluating @ {resolution}×{resolution} ({k_shot}-shot)...")
        acc, ci = evaluate(model, test_sampler, n_way=5, k_shot=k_shot, episodes=500)

    return acc, ci, model

