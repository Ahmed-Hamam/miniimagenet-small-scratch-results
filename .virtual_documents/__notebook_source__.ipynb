# ── 4. DATA SPLIT ───────────────────────────────────────────
def prepare_split(input_path, split_root):
    """
    Build a deterministic train/val/test split from the raw dataset.
    Only runs once — skips if already done.
    """
    if os.path.exists(split_root):
        print(f"✅ Split already exists at {split_root}")
        return

    print("📦 Building train/val/test split...")
    classes = sorted([
        d for d in os.listdir(input_path)
        if os.path.isdir(os.path.join(input_path, d))
    ])
    print(f"   Found {len(classes)} classes.")

    rng = random.Random(42)   # fixed seed → reproducible split
    rng.shuffle(classes)

    splits = {
        "train": classes[:64],
        "val":   classes[64:80],
        "test":  classes[80:],
    }

    for split_name, split_classes in splits.items():
        split_dir = os.path.join(split_root, split_name)
        os.makedirs(split_dir, exist_ok=True)
        for c in tqdm(split_classes, desc=f"  Copying {split_name:5s}", leave=False):
            src = os.path.join(input_path, c)
            dst = os.path.join(split_dir, c)
            if not os.path.exists(dst):
                shutil.copytree(src, dst)

    print(f"✅ Split ready → {split_root}")
    for s, cls in splits.items():
        print(f"   {s:6s}: {len(cls)} classes")

prepare_split(KAGGLE_INPUT, SPLIT_ROOT)


class LearnableNorm(nn.Module):
    """
    Learnable scaled L2 normalization.
    alpha=10 init: higher temperature sharpens inter-class distances.
    F.normalize handles division + epsilon internally.
    """
    def __init__(self):
        super().__init__()
        self.alpha = nn.Parameter(torch.ones(1) * 10)

    def forward(self, x):
        return F.normalize(x, p=2, dim=1) * self.alpha


def compute_prototype(z_support):
    """
    Compute a distance-weighted prototype for one class.

    Simple mean of support embeddings — the weighting across classes
    is handled externally by temperature scaling in MobileProtoNet.forward.
    This function is kept pure (no gamma) so it works correctly for
    any K including K=1.
    """
    return z_support.mean(dim=0)


def compute_prototype_standard(z_support):
    """
    Standard ProtoNet prototype: simple mean of support embeddings.
    Used for the ablation baseline (MobileNetV3 + standard ProtoNet head).
    No learnable norm, no dynamic gating, no weighted aggregation.
    """
    return z_support.mean(dim=0)

# ============================================
# 4. MODEL DEFINITIONS
# ============================================

def get_mobilenet_finetuned(num_classes=64, supervised=True):

    print(f"🔄 Loading MobileNetV3-SMALL (num_classes={num_classes})...")
    weights = models.MobileNet_V3_Small_Weights.DEFAULT
    model   = models.mobilenet_v3_small(weights=weights)

    if supervised:
        in_features = model.classifier[3].in_features
        model.classifier[3] = nn.Linear(in_features, num_classes)
    else:
        model.classifier = nn.Identity()

    return model


# ── Full model (our method) ─────────────────────────────────────────────────

class MobileProtoNet(nn.Module):
    """
    Our full method:
      • LearnableNorm      — scaled L2 normalization with learnable alpha
      • Learnable Gamma    — temperature scaling on the distance logits

    WHY temperature scaling instead of prototype interpolation:
    ───────────────────────────────────────────────────────────
    Previous designs tried to use gamma to interpolate between two
    prototype estimates (mean vs weighted-mean). This is mathematically
    broken for 1-shot because:

        K=1  →  weighted_mean == simple_mean  (only one support sample)
        →  gradient of any interpolation w.r.t. gamma = 0
        →  gamma freezes at its init value, confirmed in training logs

    Temperature scaling on the LOGITS (not on the prototypes) fixes this:

        logits = -gamma * cdist(z_query, z_proto)

    The gradient is:
        ∂L/∂gamma = ∂L/∂logits * (-cdist)

    cdist is never zero as long as query ≠ prototype (always true in
    practice), so gamma receives a non-zero gradient on EVERY episode,
    for ANY value of K including K=1.

    Semantics of gamma:
      gamma > 1  →  distances are amplified  →  sharper softmax  →  more decisive
      gamma < 1  →  distances are compressed →  softer softmax   →  more uncertain
      gamma = 1  →  standard ProtoNet (neutral init)

    gamma is constrained positive via F.softplus to prevent sign flipping
    which would invert the ranking of classes.
    """
    def __init__(self, backbone):
        super().__init__()
        self.backbone       = backbone
        self.learnable_norm = LearnableNorm()
        # Raw parameter for temperature; actual temperature = softplus(gamma_raw)
        # Init: softplus(0.5416) ≈ 1.0  →  same as standard ProtoNet at episode 0
        self.gamma_raw      = nn.Parameter(torch.tensor(0.5416))

    def forward(self, support_x, query_x, n_way, k_shot):
        x = torch.cat([support_x, query_x], dim=0)
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        z = torch.flatten(x, 1)

        z = self.learnable_norm(z)

        z_support = z[:support_x.size(0)]
        z_query   = z[support_x.size(0):]

        # Standard mean prototype — correct and meaningful for all K
        z_proto = torch.stack([
            compute_prototype(z_support[i * k_shot : (i + 1) * k_shot])
            for i in range(n_way)
        ])

        # gamma = softplus(gamma_raw) > 0 always
        # Scales the distance logits — gradient flows on every episode
        gamma  = F.softplus(self.gamma_raw)
        logits = -gamma * torch.cdist(z_query, z_proto)
        return logits


# ── Ablation baseline ───────────────────────────────────────────────────────

class MobileProtoNetBaseline(nn.Module):
    """
    Ablation row: MobileNetV3-Small + standard ProtoNet head.

    Removes ALL our contributions:
      • No LearnableNorm  (plain L2 normalize, fixed scale)
      • No Dynamic Gating (simple mean prototype, no gamma)

    Purpose: isolates how much of the accuracy gain comes from the
    pretrained MobileNetV3 backbone alone vs. our algorithmic additions.
    This is the row that must appear in the benchmark table so reviewers
    can attribute +X% to the backbone and +Y% to our method.
    """
    def __init__(self, backbone):
        super().__init__()
        self.backbone = backbone

    def forward(self, support_x, query_x, n_way, k_shot):
        x = torch.cat([support_x, query_x], dim=0)
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        z = torch.flatten(x, 1)

        # Standard fixed-scale L2 normalization — no learnable alpha
        z = F.normalize(z, p=2, dim=1)

        z_support = z[:support_x.size(0)]
        z_query   = z[support_x.size(0):]

        # Standard ProtoNet: simple class mean, no dynamic gating
        z_proto = torch.stack([
            compute_prototype_standard(
                z_support[i * k_shot : (i + 1) * k_shot]
            )
            for i in range(n_way)
        ])

        return -torch.cdist(z_query, z_proto)


# ── Checkpoint loaders ──────────────────────────────────────────────────────

def build_protonet_for_inference(checkpoint_path, num_classes=64):
    base_model = get_mobilenet_finetuned(num_classes=num_classes, supervised=True)
    base_model.classifier = nn.Identity()
    model = MobileProtoNet(base_model)
    model.load_state_dict(torch.load(checkpoint_path, map_location=device))
    model.to(device)
    model.eval()
    print(f"✅ Loaded checkpoint: {checkpoint_path}")
    return model


def build_baseline_for_inference(checkpoint_path, num_classes=64):
    base_model = get_mobilenet_finetuned(num_classes=num_classes, supervised=True)
    base_model.classifier = nn.Identity()
    model = MobileProtoNetBaseline(base_model)
    model.load_state_dict(torch.load(checkpoint_path, map_location=device))
    model.to(device)
    model.eval()
    print(f"✅ Loaded baseline checkpoint: {checkpoint_path}")
    return model

