# ── 3. SEED & DEVICE ────────────────────────────────────────
def set_seed(seed=42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)
        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark     = False

set_seed(SEED)
device = "cuda" if torch.cuda.is_available() else "cpu"
print(f"🔥 Device: {device}")
if device == "cuda":
    print(f"   GPU: {torch.cuda.get_device_name(0)}")

# ── 4. DATA SPLIT ───────────────────────────────────────────
def prepare_split(input_path, split_root):
    """
    Build a deterministic train/val/test split from the raw dataset.
    Only runs once — skips if already done.
    """
    if os.path.exists(split_root):
        print(f"✅ Split already exists at {split_root}")
        return

    print("📦 Building train/val/test split...")
    classes = sorted([
        d for d in os.listdir(input_path)
        if os.path.isdir(os.path.join(input_path, d))
    ])
    print(f"   Found {len(classes)} classes.")

    rng = random.Random(42)   # fixed seed → reproducible split
    rng.shuffle(classes)

    splits = {
        "train": classes[:64],
        "val":   classes[64:80],
        "test":  classes[80:],
    }

    for split_name, split_classes in splits.items():
        split_dir = os.path.join(split_root, split_name)
        os.makedirs(split_dir, exist_ok=True)
        for c in tqdm(split_classes, desc=f"  Copying {split_name:5s}", leave=False):
            src = os.path.join(input_path, c)
            dst = os.path.join(split_dir, c)
            if not os.path.exists(dst):
                shutil.copytree(src, dst)

    print(f"✅ Split ready → {split_root}")
    for s, cls in splits.items():
        print(f"   {s:6s}: {len(cls)} classes")

prepare_split(KAGGLE_INPUT, SPLIT_ROOT)

# ── 5. WEIGHT INIT ──────────────────────────────────────────
def init_weights_kaiming(m):
    if isinstance(m, (nn.Conv2d, nn.ConvTranspose2d)):
        nn.init.kaiming_normal_(m.weight, mode="fan_out", nonlinearity="relu")
        if m.bias is not None: nn.init.zeros_(m.bias)
    elif isinstance(m, (nn.BatchNorm2d, nn.GroupNorm)):
        nn.init.ones_(m.weight); nn.init.zeros_(m.bias)
    elif isinstance(m, nn.Linear):
        nn.init.kaiming_normal_(m.weight, mode="fan_out", nonlinearity="relu")
        if m.bias is not None: nn.init.zeros_(m.bias)

# ── 6. MODULES ──────────────────────────────────────────────
class LearnableNorm(nn.Module):
    def __init__(self):
        super().__init__()
        self.alpha = nn.Parameter(torch.ones(1) * 10)
    def forward(self, x):
        return F.normalize(x, p=2, dim=1) * self.alpha


def compute_prototype(z_support, gamma):
    z_mean         = z_support.mean(dim=0, keepdim=True)
    dists          = torch.norm(z_support - z_mean, dim=1)
    weights        = torch.softmax(-dists, dim=0)
    adaptive_proto = torch.sum(weights.unsqueeze(1) * z_support, dim=0)
    lam            = torch.sigmoid(gamma)
    return (1 - lam) * z_mean.squeeze(0) + lam * adaptive_proto


def compute_prototype_standard(z_support):
    return z_support.mean(dim=0)

# ── 7. MODELS ───────────────────────────────────────────────
def get_mobilenet_scratch(num_classes=64, supervised=True):
    model = models.mobilenet_v3_small(weights=None)
    model.apply(init_weights_kaiming)
    if supervised:
        in_f = model.classifier[3].in_features
        model.classifier[3] = nn.Linear(in_f, num_classes)
        nn.init.kaiming_normal_(model.classifier[3].weight)
        nn.init.zeros_(model.classifier[3].bias)
    else:
        model.classifier = nn.Identity()
    return model


class MobileProtoNet(nn.Module):
    """Full method: LearnableNorm + Dynamic Gated Prototype."""
    def __init__(self, backbone):
        super().__init__()
        self.backbone       = backbone
        self.learnable_norm = LearnableNorm()
        self.gamma          = nn.Parameter(torch.zeros(1))

    def forward(self, support_x, query_x, n_way, k_shot):
        x = torch.cat([support_x, query_x], dim=0)
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        z = torch.flatten(x, 1)
        z = self.learnable_norm(z)

        z_sup = z[:support_x.size(0)]
        z_qry = z[support_x.size(0):]

        protos = torch.stack([
            compute_prototype(z_sup[i*k_shot:(i+1)*k_shot], self.gamma)
            for i in range(n_way)
        ])
        return -torch.cdist(z_qry, protos)


class MobileProtoNetBaseline(nn.Module):
    """Ablation: standard mean prototype, fixed L2 norm."""
    def __init__(self, backbone):
        super().__init__()
        self.backbone = backbone

    def forward(self, support_x, query_x, n_way, k_shot):
        x = torch.cat([support_x, query_x], dim=0)
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        z = torch.flatten(x, 1)
        z = F.normalize(z, p=2, dim=1)

        z_sup = z[:support_x.size(0)]
        z_qry = z[support_x.size(0):]

        protos = torch.stack([
            compute_prototype_standard(z_sup[i*k_shot:(i+1)*k_shot])
            for i in range(n_way)
        ])
        return -torch.cdist(z_qry, protos)


def load_protonet(path):
    base = get_mobilenet_scratch(supervised=True)
    base.classifier = nn.Identity()
    m = MobileProtoNet(base)
    m.load_state_dict(torch.load(path, map_location=device))
    return m.to(device).eval()


def load_baseline(path):
    base = get_mobilenet_scratch(supervised=True)
    base.classifier = nn.Identity()
    m = MobileProtoNetBaseline(base)
    m.load_state_dict(torch.load(path, map_location=device))
    return m.to(device).eval()

# ── 8. TRANSFORMS & EPISODIC SAMPLER ────────────────────────
train_transform = transforms.Compose([
    transforms.Resize(96),
    transforms.RandomCrop(IMG_SIZE),
    transforms.RandomHorizontalFlip(),
    transforms.ColorJitter(0.4, 0.4, 0.4, 0.1),
    transforms.RandomGrayscale(p=0.05),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
])

test_transform = transforms.Compose([
    transforms.Resize(96),
    transforms.CenterCrop(IMG_SIZE),
    transforms.ToTensor(),
    transforms.Normalize([0.485, 0.456, 0.406], [0.229, 0.224, 0.225]),
])


class EpisodicSampler:
    def __init__(self, root, transform):
        self.classes = sorted(os.listdir(root))
        self.data    = {}
        for c in self.classes:
            cp = os.path.join(root, c)
            self.data[c] = [
                os.path.join(cp, f) for f in os.listdir(cp)
                if f.lower().endswith(("jpg","jpeg","png"))
            ]
        self.transform = transform

    def get_episode(self, n_way, k_shot, q_query=15):
        selected = random.sample(self.classes, n_way)
        sup, qry, lbl = [], [], []
        for i, cls in enumerate(selected):
            imgs  = self.data[cls]
            need  = k_shot + q_query
            paths = (random.choices(imgs, k=need) if len(imgs) < need
                     else random.sample(imgs, need))
            for p in paths[:k_shot]:
                sup.append(self.transform(Image.open(p).convert("RGB")))
            for p in paths[k_shot:]:
                qry.append(self.transform(Image.open(p).convert("RGB")))
                lbl.append(i)
        return torch.stack(sup), torch.stack(qry), torch.tensor(lbl)


train_sampler = EpisodicSampler(os.path.join(SPLIT_ROOT, "train"), test_transform)
val_sampler   = EpisodicSampler(os.path.join(SPLIT_ROOT, "val"),   test_transform)
test_sampler  = EpisodicSampler(os.path.join(SPLIT_ROOT, "test"),  test_transform)
print(f"\n✅ Samplers ready  —  "
      f"train: {len(train_sampler.classes)} cls | "
      f"val: {len(val_sampler.classes)} cls | "
      f"test: {len(test_sampler.classes)} cls")

# ── 9. LR SCHEDULE ──────────────────────────────────────────
def get_lr(epoch, total, warmup, base_lr):
    if epoch < warmup:
        return base_lr * (epoch + 1) / warmup
    p = (epoch - warmup) / (total - warmup)
    return base_lr * 0.5 * (1 + math.cos(math.pi * p))

# ── 10. STAGE 1 — BACKBONE PRE-TRAINING ─────────────────────
BACKBONE_PATH = os.path.join(KAGGLE_WORKING, "backbone_final.pth")

def stage1_train(epochs=STAGE1_EPOCHS):
    print(f"\n{'='*60}")
    print(f"🦾 STAGE 1: Backbone pre-training ({epochs} epochs, {IMG_SIZE}×{IMG_SIZE})")
    print(f"{'='*60}")

    train_dataset = datasets.ImageFolder(
        root=os.path.join(SPLIT_ROOT, "train"),
        transform=train_transform,
    )
    train_loader = DataLoader(
        train_dataset, batch_size=64, shuffle=True,
        num_workers=2, pin_memory=True,
    )

    BASE_LR, WARMUP = 0.1, 5
    model     = get_mobilenet_scratch(num_classes=64, supervised=True).to(device)
    optimizer = torch.optim.SGD(
        model.parameters(), lr=BASE_LR,
        momentum=0.9, weight_decay=1e-4, nesterov=True,
    )
    criterion = nn.CrossEntropyLoss()

    for epoch in range(epochs):
        lr = get_lr(epoch, epochs, WARMUP, BASE_LR)
        for pg in optimizer.param_groups: pg["lr"] = lr

        model.train()
        total_loss, correct, total = 0.0, 0, 0
        pbar = tqdm(train_loader,
                    desc=f"Ep {epoch+1:03d}/{epochs}  lr={lr:.5f}",
                    leave=False)

        for imgs, labels in pbar:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            out  = model(imgs)
            loss = criterion(out, labels)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            correct    += (out.argmax(1) == labels).sum().item()
            total      += labels.size(0)
            pbar.set_postfix(Acc=f"{correct/total:.1%}", Loss=f"{loss.item():.3f}")

        print(f"  Ep {epoch+1:03d}: loss={total_loss/len(train_loader):.4f}  "
              f"acc={correct/total:.2%}  lr={lr:.5f}")

        # periodic checkpoints (safe against Kaggle session timeout)
        if (epoch + 1) % 25 == 0:
            ckpt = os.path.join(KAGGLE_WORKING, f"backbone_ep{epoch+1}.pth")
            torch.save(model.state_dict(), ckpt)
            print(f"  💾 Checkpoint → {ckpt}")

    torch.save(model.state_dict(), BACKBONE_PATH)
    print(f"\n✅ Stage 1 done.  Backbone saved → {BACKBONE_PATH}")
    return model


if not os.path.exists(BACKBONE_PATH):
    stage1_train(STAGE1_EPOCHS)
else:
    print(f"✅ Backbone already trained — skipping Stage 1.\n   ({BACKBONE_PATH})")

# ── 11. STAGE 2 — META-TRAINING ─────────────────────────────
@torch.no_grad()
def evaluate(model, sampler, n_way, k_shot, episodes=500, silent=False):
    model.eval()
    accs = []
    itr  = range(episodes) if silent else tqdm(range(episodes), desc="Eval", leave=False)
    for _ in itr:
        sx, qx, qy = sampler.get_episode(n_way, k_shot)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)
        preds = model(sx, qx, n_way, k_shot).argmax(1)
        accs.append((preds == qy).float().mean().item())
    mean, ci = np.mean(accs), 1.96 * np.std(accs) / np.sqrt(episodes)
    if not silent: print(f"  📊 {mean:.2%} ± {ci:.2%}")
    return mean, ci


def meta_train(backbone_path, k_shot, episodes, use_full_method, n_way=N_WAY):
    tag   = "full"     if use_full_method else "baseline"
    label = "Full Method (LearnableNorm + DynGate)" if use_full_method else "Ablation Baseline"
    save  = os.path.join(KAGGLE_WORKING, f"best_{tag}_{k_shot}shot.pth")

    print(f"\n{'='*60}")
    print(f"🧠 STAGE 2 [{label}]")
    print(f"   {n_way}-way {k_shot}-shot  |  {episodes} episodes")
    print(f"{'='*60}")

    base = get_mobilenet_scratch(num_classes=64, supervised=True)
    base.load_state_dict(torch.load(backbone_path, map_location=device))
    base.classifier = nn.Identity()

    model     = (MobileProtoNet(base) if use_full_method
                 else MobileProtoNetBaseline(base)).to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
    criterion = nn.CrossEntropyLoss()

    best_val, patience = 0.0, 0

    for ep in tqdm(range(episodes), desc=f"Meta [{tag}] {k_shot}-shot"):
        sx, qx, qy = train_sampler.get_episode(n_way, k_shot)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        model.train()
        optimizer.zero_grad()
        loss = criterion(model(sx, qx, n_way, k_shot), qy)
        loss.backward()
        optimizer.step()

        if (ep + 1) % 200 == 0:
            val_acc, _ = evaluate(model, val_sampler, n_way, k_shot,
                                  episodes=200, silent=True)
            extra = ""
            if use_full_method:
                extra = (f"  α={model.learnable_norm.alpha.item():.4f}"
                         f"  γ={model.gamma.item():.4f}")
            print(f"  ep {ep+1:4d}: loss={loss.item():.4f}  "
                  f"val={val_acc:.2%}{extra}")

            if val_acc > best_val:
                best_val = val_acc
                torch.save(model.state_dict(), save)
                print(f"  💾 Best saved → {save}")
                patience = 0
            else:
                patience += 1
                if patience > 10:
                    print("  ⏹️  Early stopping.")
                    break

    print(f"\n✅ Meta-training done.  Best val: {best_val:.2%}")
    return model, save


# Run all four configurations
