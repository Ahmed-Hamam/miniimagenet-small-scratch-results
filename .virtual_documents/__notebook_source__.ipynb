CKPT_DIR = "/kaggle/working"  # عدّل لو الملفات في مكان تاني

def discover_checkpoints(ckpt_dir=CKPT_DIR):
    """
    يفحص الملفات ويبني:
    { input_size: { seed: { k_shot: ckpt_path } } }
    من نمط الاسم: best_resnet_proto_miniimagenet_{size}px_seed{seed}_{k}shot.pth
    """
    pattern = re.compile(
        r"best_resnet_proto_miniimagenet_(\d+)px_seed(\d+)_(\d+)shot\.pth$"
    )
    found = {}
    for path in glob.glob(os.path.join(ckpt_dir, "best_resnet_proto_miniimagenet_*.pth")):
        m = pattern.search(os.path.basename(path))
        if not m:
            continue
        size, seed, k = int(m.group(1)), int(m.group(2)), int(m.group(3))
        found.setdefault(size, {}).setdefault(seed, {})[k] = path
    return found


CKPTS = discover_checkpoints()

