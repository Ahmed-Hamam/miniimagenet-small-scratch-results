# يطبع توزيع أحجام الصور الأصلية في داتاست miniImageNet و CUB على Kaggle.
# لو miniImageNet صورها 84x84 (أو صغيرة) → تشغيل 224 هو upsampling فقط.
#
# الاستخدام: الصق في خلية Kaggle (الداتاستات لازم تكون Input) وشغّل.
# تقدر تحدد المسارات يدويًا في PATHS، أو سيبها فاضية للبحث التلقائي.
import os, sys, random, collections
from PIL import Image

KAGGLE_INPUT = "/kaggle/input"
PATHS = {}          # مثال: {"miniImageNet": "/kaggle/input/xxx", "CUB": "/kaggle/input/yyy"}
SAMPLE_PER_DATASET = 3000   # None = كل الصور (أبطأ)
EXTS = (".jpg", ".jpeg", ".png", ".bmp", ".webp")


def list_images(root):
    out = []
    for r, _, fs in os.walk(root):
        for f in fs:
            if f.lower().endswith(EXTS):
                out.append(os.path.join(r, f))
    return out


def autodetect():
    found = {}
    if not os.path.isdir(KAGGLE_INPUT):
        return found
    for d in sorted(os.listdir(KAGGLE_INPUT)):
        low = d.lower()
        full = os.path.join(KAGGLE_INPUT, d)
        if "mini" in low and "imagenet" in low:
            found.setdefault("miniImageNet", full)
        elif "cub" in low or "bird" in low:
            found.setdefault("CUB", full)
    return found


def report(name, root):
    print("\n" + "=" * 60)
    print(f"📊 {name}  ←  {root}")
    print("=" * 60)
    imgs = list_images(root)
    print(f"إجمالي الصور: {len(imgs)}")
    if not imgs:
        return
    random.Random(0).shuffle(imgs)
    if SAMPLE_PER_DATASET:
        imgs = imgs[:SAMPLE_PER_DATASET]
    sizes, bad = collections.Counter(), 0
    mins = []
    for p in imgs:
        try:
            with Image.open(p) as im:
                w, h = im.size
            sizes[(w, h)] += 1
            mins.append(min(w, h))
        except Exception:
            bad += 1
    n = len(mins)
    print(f"اتفحص: {n} صورة (تالف/مش مقروء: {bad})")
    print("أكتر الأحجام شيوعًا (W×H):")
    for (w, h), c in sizes.most_common(8):
        print(f"   {w}×{h}: {c} ({c / n:.1%})")
    mins.sort()
    q = lambda p: mins[min(n - 1, int(p * n))]
    print(f"أقصر ضلع — min={mins[0]} | median={q(0.5)} | p90={q(0.9)} | max={mins[-1]}")
    small = sum(m <= 100 for m in mins) / n
    below224 = sum(m < 224 for m in mins) / n
    print(f"نسبة الصور ≤100px: {small:.1%} | أصغر من 224px: {below224:.1%}")
    if small > 0.9:
        print("⚠️  الداتاست جاهز بحجم صغير (~84) → 224 مجرد upsampling، مفيش معلومات زيادة.")
    elif below224 > 0.5:
        print("ℹ️  معظم الصور أصغر من 224 → 224 فيه upsampling جزئي.")
    else:
        print("✅ الصور الأصلية كبيرة كفاية: 224 مش upsampling.")


print("📂 محتوى /kaggle/input:")
if os.path.isdir(KAGGLE_INPUT):
    for d in sorted(os.listdir(KAGGLE_INPUT)):
        print("   -", d)
else:
    print("   (المجلد مش موجود — أنت مش على Kaggle؟)")

paths = PATHS or autodetect()
if not paths:
    # مفيش اسم مطابق → افحص كل داتاست موجودة في Input
    if os.path.isdir(KAGGLE_INPUT):
        paths = {d: os.path.join(KAGGLE_INPUT, d) for d in sorted(os.listdir(KAGGLE_INPUT))}
    if paths:
        print("\nℹ️  مفيش اسم مطابق لـ miniImageNet/CUB، فهفحص كل الداتاستات الموجودة.")
if not paths:
    print("❌ مفيش أي داتاست في /kaggle/input. ضيفها من Add Input (يمين النوتبوك) "
          "ثم شغّل تاني، أو عبّي PATHS يدويًا.")
else:
    for k, v in paths.items():
        report(k, v)


# Latency + Memory benchmark: MobileNetV3-Small / MobileNetV3-Large / ResNet-18
# resolutions × (batch=1 | 1-shot episode | 5-shot episode) × (infer | train step)
# على نفس الـ GPU (+ CPU اختياري). weights=None (الـ latency مش بيتأثر بالأوزان).
# يشتغل على Kaggle/Colab/محلي. بيحفظ CSV + JSON فيهم metadata كاملة.
import os, sys, json, time, platform, statistics
import torch, torch.nn as nn
import torchvision, torchvision.models as models
from torch.utils.flop_counter import FlopCounterMode

# ================= إعدادات =================
BACKBONES   = ["mobilenet_v3_small", "mobilenet_v3_large", "resnet18"]
RESOLUTIONS = [84, 112, 168, 224]
N_WAY, Q_QUERY = 5, 15
SHOTS       = [1, 5]                 # episode = N_WAY*(k+Q_QUERY) صورة
RUN_BS1     = True                   # latency لصورة واحدة (سيناريو deployment)
RUN_TRAIN   = True                   # forward+backward لـ episode (ذاكرة التدريب)
PRECISIONS  = ["fp32", "fp16"]       # fp16 = autocast (GPU فقط)
GPU_WARMUP, GPU_ITERS = 30, 300
RUN_CPU     = True
CPU_THREADS = [1, 4]                 # الأعداد اللي هتتجرّب
CPU_WARMUP, CPU_ITERS = 5, 30
OUT_DIR     = "/kaggle/working" if os.path.isdir("/kaggle/working") else "."
SEED        = 0
# ===========================================

torch.manual_seed(SEED)
HAS_CUDA = torch.cuda.is_available()


def make_backbone(name):
    m = getattr(models, name)(weights=None)
    if name.startswith("mobilenet"):
        m.classifier = nn.Identity()
    else:
        m.fc = nn.Identity()
    return m


def proto_logits(z, n_way, k, q):
    zs, zq = z[: n_way * k], z[n_way * k:]
    protos = zs.view(n_way, k, -1).mean(1)
    return -torch.cdist(zq, protos) ** 2


def count_flops(model, res, bs=1):
    x = torch.randn(bs, 3, res, res)
    with FlopCounterMode(display=False) as fc, torch.no_grad():
        model.cpu().eval()(x)
    return fc.get_total_flops() / 2 / bs   # MACs لكل صورة


def stats(ts):
    ts = sorted(ts)
    n = len(ts)
    return dict(mean_ms=statistics.fmean(ts), median_ms=ts[n // 2],
                std_ms=statistics.pstdev(ts), p95_ms=ts[min(n - 1, int(.95 * n))])


def bench(model, x, mode, dev, prec, warm, iters, n_way, k, q):
    """mode: infer | train. يرجّع إحصائيات الزمن (ms) + peak memory (MB, GPU فقط)"""
    gpu = dev.type == "cuda"
    amp = gpu and prec == "fp16"
    labels = torch.arange(n_way, device=dev).repeat_interleave(q) if mode == "train" else None
    opt = torch.optim.SGD(model.parameters(), lr=1e-6) if mode == "train" else None

    def step():
        with torch.autocast(device_type=dev.type, dtype=torch.float16, enabled=amp):
            if mode == "infer":
                with torch.inference_mode():
                    z = model(x)
                    if k is not None:
                        proto_logits(z.float(), n_way, k, q)
            else:
                z = model(x)
                loss = nn.functional.cross_entropy(proto_logits(z.float(), n_way, k, q), labels)
        if mode == "train":
            opt.zero_grad(set_to_none=True)
            loss.backward()
            opt.step()

    model.train(mode == "train")
    if mode == "infer":
        model.eval()
    for _ in range(warm):
        step()
    if gpu:
        torch.cuda.synchronize()
        torch.cuda.empty_cache()
        torch.cuda.reset_peak_memory_stats()
        base = torch.cuda.memory_allocated()
    ts = []
    for _ in range(iters):
        if gpu:
            s, e = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
            torch.cuda.synchronize()
            s.record(); step(); e.record()
            torch.cuda.synchronize()
            ts.append(s.elapsed_time(e))
        else:
            t0 = time.perf_counter(); step(); ts.append((time.perf_counter() - t0) * 1e3)
    out = stats(ts)
    if gpu:
        out["peak_mem_MB"] = torch.cuda.max_memory_allocated() / 2**20
        out["act_mem_MB"] = (torch.cuda.max_memory_allocated() - base) / 2**20
    return out


def configs():
    cfgs = []
    if RUN_BS1:
        cfgs.append(("bs1", 1, None))
    for k in SHOTS:
        cfgs.append((f"{k}shot", N_WAY * (k + Q_QUERY), k))
    return cfgs


def run_device(dev, label, rows, warm, iters, precs, threads=None):
    for name in BACKBONES:
        for res in RESOLUTIONS:
            macs = count_flops(make_backbone(name), res)
            for cname, bs, k in configs():
                for mode in (["infer", "train"] if RUN_TRAIN else ["infer"]):
                    if mode == "train" and k is None:
                        continue
                    if mode == "train" and dev.type == "cpu":
                        continue
                    for prec in precs:
                        model = make_backbone(name).to(dev)
                        params = sum(p.numel() for p in model.parameters()) / 1e6
                        x = torch.randn(bs, 3, res, res, device=dev)
                        try:
                            r = bench(model, x, mode, dev, prec, warm, iters,
                                      N_WAY, k, Q_QUERY)
                        except RuntimeError as ex:
                            if "out of memory" in str(ex).lower():
                                print(f"  OOM: {name} {res} {cname} {mode} {prec}")
                                torch.cuda.empty_cache(); continue
                            raise
                        row = dict(device=label, threads=threads, backbone=name, res=res,
                                   config=cname, batch=bs, mode=mode, precision=prec,
                                   params_M=round(params, 3), MACs_G=round(macs / 1e9, 4), **r)
                        rows.append(row)
                        print(f"[{label}] {name:19s} {res:3d}px {cname:6s} {mode:5s} {prec} "
                              f"| {r['median_ms']:8.2f} ms (p95 {r['p95_ms']:.2f})"
                              + (f" | peak {r['peak_mem_MB']:.0f} MB" if 'peak_mem_MB' in r else ""))
                        del model, x
                        if dev.type == "cuda":
                            torch.cuda.empty_cache()


def main():
    meta = dict(torch=torch.__version__, torchvision=torchvision.__version__,
                python=platform.python_version(), platform=platform.platform(),
                cpu=platform.processor(), cpu_count=os.cpu_count(),
                cuda=torch.version.cuda, cudnn=torch.backends.cudnn.version(),
                gpu=torch.cuda.get_device_name(0) if HAS_CUDA else None,
                gpu_mem_GB=round(torch.cuda.get_device_properties(0).total_memory / 2**30, 1) if HAS_CUDA else None,
                precisions=PRECISIONS, gpu_warmup=GPU_WARMUP, gpu_iters=GPU_ITERS,
                cpu_warmup=CPU_WARMUP, cpu_iters=CPU_ITERS, n_way=N_WAY, q_query=Q_QUERY,
                cudnn_benchmark=True)
    print(json.dumps(meta, indent=1, ensure_ascii=False))
    rows = []
    if HAS_CUDA:
        torch.backends.cudnn.benchmark = True
        run_device(torch.device("cuda"), "gpu", rows, GPU_WARMUP, GPU_ITERS, PRECISIONS)
    else:
        print("⚠️ مفيش GPU — هتتقاس CPU بس.")
    if RUN_CPU:
        for t in CPU_THREADS:
            torch.set_num_threads(t)
            run_device(torch.device("cpu"), "cpu", rows, CPU_WARMUP, CPU_ITERS, ["fp32"], threads=t)

    import csv
    keys = sorted({k for r in rows for k in r}, key=lambda k: list(rows[0]).index(k) if k in rows[0] else 99)
    csvp = os.path.join(OUT_DIR, "latency_memory_benchmark.csv")
    with open(csvp, "w", newline="") as f:
        w = csv.DictWriter(f, fieldnames=keys); w.writeheader(); w.writerows(rows)
    with open(os.path.join(OUT_DIR, "latency_memory_benchmark.json"), "w") as f:
        json.dump(dict(meta=meta, rows=rows), f, indent=1)
    print(f"\n💾 saved: {csvp}")
    summary(rows)


def summary(rows):
    def get(dev, bb, res, cfg, mode, prec, thr=None):
        for r in rows:
            if (r["device"], r["backbone"], r["res"], r["config"], r["mode"], r["precision"]) == \
               (dev, bb, res, cfg, mode, prec) and (thr is None or r["threads"] == thr):
                return r
    print("\n" + "=" * 78)
    print("🔑 الـ claim الرئيسي: MobileNetV3-Small@224  vs  MobileNetV3-Large@84")
    print("=" * 78)
    combos = [("gpu", p, None) for p in PRECISIONS] if HAS_CUDA else []
    combos += [("cpu", "fp32", t) for t in (CPU_THREADS if RUN_CPU else [])]
    for dev, prec, thr in combos:
        for cfg in (["bs1"] if RUN_BS1 else []) + [f"{k}shot" for k in SHOTS]:
            for mode in ["infer"] + (["train"] if dev == "gpu" and RUN_TRAIN and cfg != "bs1" else []):
                a = get(dev, "mobilenet_v3_small", 224, cfg, mode, prec, thr)
                b = get(dev, "mobilenet_v3_large", 84, cfg, mode, prec, thr)
                if not a or not b:
                    continue
                s = f"{dev}{'-'+str(thr)+'t' if thr else ''} {prec} {cfg:6s} {mode:5s}: " \
                    f"Small@224 {a['median_ms']:.2f} ms vs Large@84 {b['median_ms']:.2f} ms " \
                    f"→ latency ratio {a['median_ms']/b['median_ms']:.2f}×"
                if "peak_mem_MB" in a:
                    s += f" | mem {a['peak_mem_MB']:.0f} vs {b['peak_mem_MB']:.0f} MB " \
                         f"({a['peak_mem_MB']/b['peak_mem_MB']:.2f}×)"
                print(s)
    a = get("gpu" if HAS_CUDA else "cpu", "mobilenet_v3_small", 224, "bs1" if RUN_BS1 else "1shot", "infer",
            "fp32", None if HAS_CUDA else CPU_THREADS[0])
    b = get("gpu" if HAS_CUDA else "cpu", "mobilenet_v3_large", 84, "bs1" if RUN_BS1 else "1shot", "infer",
            "fp32", None if HAS_CUDA else CPU_THREADS[0])
    if a and b:
        print(f"\nMACs ratio Small@224/Large@84 = {a['MACs_G']/b['MACs_G']:.2f}× | "
              f"params ratio = {a['params_M']/b['params_M']:.2f}×")
    print("ملاحظة: لو latency ratio أقل/أكبر بوضوح من MACs ratio → الـ MobileNets memory-bound "
          "(الـ MACs وحدها مش بتتنبأ بالزمن).")


if __name__ == "__main__":
    main()


