    print(f"  FINAL SUMMARY — MobileNetV3-Large (standard ProtoNet baseline) on miniImageNet")
    print(f"  Aggregated over {len(SEEDS)} seeds: {list(SEEDS)}")
    print("=" * 60)
    for agg in (mnv3_multiseed_84, mnv3_multiseed_224):
        r = agg["resolution"]
        print(f"\n  @ {r}x{r}  (n={agg['n_seeds']} seeds)")
        print(f"    1-shot: {agg['1shot_mean']:.2%} +/- {agg['1shot_std']:.2%}")
        print(f"    5-shot: {agg['5shot_mean']:.2%} +/- {agg['5shot_std']:.2%}")
        if agg["gflops_mean"] is not None:
