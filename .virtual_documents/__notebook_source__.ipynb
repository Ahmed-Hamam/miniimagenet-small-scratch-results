STAGE_TIMES = {}

class StageTimer:
    """Context manager that records wall-clock time for a named stage."""
    def __init__(self, name):
        self.name = name

    def __enter__(self):
        self.t0 = time.time()
        print(f"\n[{self.name}] started...")
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        elapsed = time.time() - self.t0
        STAGE_TIMES[self.name] = elapsed
        print(f"[{self.name}] finished in {elapsed:.1f}s ({elapsed/60:.2f} min)")


def print_stage_time_summary():
    if not STAGE_TIMES:
        print("No stage timings recorded yet.")
        return
    print("\n" + "=" * 50)
    print("STAGE TIME SUMMARY")
    print("=" * 50)
    total = 0.0
    for name, secs in STAGE_TIMES.items():
        print(f"  {name:45s} {secs:8.1f}s  ({secs/60:.2f} min)")
        total += secs
    print(f"  {'TOTAL':45s} {total:8.1f}s  ({total/60:.2f} min)")

# ============================================
# 2. PARAMETER, FLOPs, LATENCY, MEMORY PROFILING
# ============================================

def count_parameters(model, trainable_only=False):
    if trainable_only:
        return sum(p.numel() for p in model.parameters() if p.requires_grad)
    return sum(p.numel() for p in model.parameters())


class _MobileLargeFeatureExtractor(nn.Module):
    """
    Wraps the MobileNetV3 backbone's feature-extraction path as a
    proper nn.Module (NOT a plain closure). This matters: thop
    profiles FLOPs by walking nn.Module.modules(), so the backbone
    must be a registered submodule (self.backbone = backbone) or
    thop silently reports 0 MACs regardless of model size.
    """
    def __init__(self, backbone):
        super().__init__()
        self.backbone = backbone

    def forward(self, x):
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        return torch.flatten(x, 1)


def compute_flops(backbone_module, input_size, device=device):
    """
    FLOPs (MACs) and params for the backbone feature-extraction pass
    only, using thop on a single dummy image — matches the paper's
    efficiency-table methodology.
    """
    wrapper = _MobileLargeFeatureExtractor(backbone_module).to(device).eval()
    dummy = torch.randn(1, 3, input_size, input_size).to(device)

    with torch.no_grad():
        macs, params = thop_profile(wrapper, inputs=(dummy,), verbose=False)

    gflops = macs / 1e9
    params_m = params / 1e6
    print(f"Backbone profile @ {input_size}x{input_size}: "
          f"{params_m:.2f}M params | {gflops:.4f} GFLOPs (MACs)")
    return {"params": params, "params_M": params_m, "macs": macs, "gflops": gflops}


def measure_inference_latency(model, resolution, n_way=5, k_shot=1, q_query=15,
                                device=device, n_warmup=10, n_runs=100):
    """
    Per-episode inference latency (support + query forward pass).
    Warmup runs are excluded because the first CUDA calls include
    kernel compilation/caching overhead. torch.cuda.synchronize() is
    used around timing to avoid CUDA async-dispatch measurement error.
    """
    model.eval()
    support_x = torch.randn(n_way * k_shot, 3, resolution, resolution).to(device)
    query_x   = torch.randn(n_way * q_query, 3, resolution, resolution).to(device)

    with torch.no_grad():
        for _ in range(n_warmup):
            _ = model(support_x, query_x, n_way, k_shot)
    if device == "cuda":
        torch.cuda.synchronize()

    latencies = []
    with torch.no_grad():
        for _ in range(n_runs):
            if device == "cuda":
                torch.cuda.synchronize()
            start = time.perf_counter()
            _ = model(support_x, query_x, n_way, k_shot)
            if device == "cuda":
                torch.cuda.synchronize()
            end = time.perf_counter()
            latencies.append((end - start) * 1000)  # ms

    latencies = np.array(latencies)
    return {
        "mean_latency_ms": float(latencies.mean()),
        "std_latency_ms": float(latencies.std()),
        "throughput_episodes_per_sec": 1000.0 / float(latencies.mean()),
    }


def measure_gpu_memory(model, resolution, n_way=5, k_shot=1, q_query=15, device=device):
    """
    Peak GPU memory (MB) for a single forward pass. Resets the CUDA
    peak-memory counter first so the result reflects only this
    forward pass, not accumulated allocator state.
    """
    if device != "cuda":
        print("GPU memory measurement skipped (no CUDA device).")
        return {"peak_memory_mb": None}

    model.eval()
    support_x = torch.randn(n_way * k_shot, 3, resolution, resolution).to(device)
    query_x   = torch.randn(n_way * q_query, 3, resolution, resolution).to(device)

    torch.cuda.reset_peak_memory_stats()
    torch.cuda.synchronize()
    with torch.no_grad():
        _ = model(support_x, query_x, n_way, k_shot)
    torch.cuda.synchronize()

    peak_mb = torch.cuda.max_memory_allocated() / 1e6
    return {"peak_memory_mb": peak_mb}


def report_full_efficiency(model, resolution):
    """
    Full efficiency report: total/trainable params, backbone FLOPs,
    inference latency, peak GPU memory. Matches the report_full_model_stats()
    output from the original 84x84/224x224 scripts, extended with
    latency and memory.
    """
    print(f"\nEfficiency report @ {resolution}x{resolution}")
    total_params = count_parameters(model)
    trainable_params = count_parameters(model, trainable_only=True)
    print(f"  Full model: {total_params/1e6:.3f}M total params | "
          f"{trainable_params/1e6:.3f}M trainable params")

    flops_info = compute_flops(model.backbone, input_size=resolution)
    lat_info = measure_inference_latency(model, resolution)
    mem_info = measure_gpu_memory(model, resolution)

    print(f"  Latency: {lat_info['mean_latency_ms']:.2f}+/-{lat_info['std_latency_ms']:.2f} ms "
          f"({lat_info['throughput_episodes_per_sec']:.1f} episodes/sec)")
    if mem_info["peak_memory_mb"] is not None:
        print(f"  Peak GPU memory: {mem_info['peak_memory_mb']:.1f} MB")

    return {
        "resolution": resolution,
        "total_params": total_params,
        "trainable_params": trainable_params,
        **flops_info,
        **lat_info,
        **mem_info,
    }

