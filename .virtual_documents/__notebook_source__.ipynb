# ── 1. PATHS ────────────────────────────────────────────────
KAGGLE_WORKING = "/kaggle/working"
SPLIT_ROOT     = os.path.join(KAGGLE_WORKING, "miniimagenet_split")

def find_dataset_root(base="/kaggle/input"):
    """
    Auto-detect where MiniImageNet class folders actually live.
    Scans up to 3 levels deep under /kaggle/input and returns the
    first directory that contains ≥ 20 subdirectories (class folders).
    """
    print(f"\n🔍 Scanning {base} for dataset root...")
    for entry in sorted(os.listdir(base)):
        lvl1 = os.path.join(base, entry)
        if not os.path.isdir(lvl1):
            continue
        subdirs = [d for d in os.listdir(lvl1) if os.path.isdir(os.path.join(lvl1, d))]
        if len(subdirs) >= 20:
            print(f"   ✅ Found at: {lvl1}  ({len(subdirs)} class folders)")
            return lvl1
        for entry2 in sorted(subdirs):
            lvl2 = os.path.join(lvl1, entry2)
            subdirs2 = [d for d in os.listdir(lvl2) if os.path.isdir(os.path.join(lvl2, d))]
            if len(subdirs2) >= 20:
                print(f"   ✅ Found at: {lvl2}  ({len(subdirs2)} class folders)")
                return lvl2
            # Check one level deeper (level 3)
            for entry3 in sorted(subdirs2):
                lvl3 = os.path.join(lvl2, entry3)
                if not os.path.isdir(lvl3):
                    continue
                subdirs3 = [d for d in os.listdir(lvl3) if os.path.isdir(os.path.join(lvl3, d))]
                if len(subdirs3) >= 20:
                    print(f"   ✅ Found at: {lvl3}  ({len(subdirs3)} class folders)")
                    return lvl3

    # Fallback: print tree to help debug, then raise
    print("\n❌ Could not find dataset. Contents of /kaggle/input:")
    for entry in sorted(os.listdir(base)):
        lvl1 = os.path.join(base, entry)
        print(f"   {lvl1}/")
        if os.path.isdir(lvl1):
            for sub in sorted(os.listdir(lvl1))[:5]:
                print(f"      {sub}/")
    raise FileNotFoundError(
        "MiniImageNet class folders not found under /kaggle/input.\n"
        "Make sure you added the dataset: "
        "https://www.kaggle.com/datasets/arjunashok33/miniimagenet"
    )
KAGGLE_INPUT = find_dataset_root()

# ── 2. CONFIG ───────────────────────────────────────────────
IMG_SIZE       = 84
