def _default_data_root():
    if os.path.isdir("/kaggle/working"):
        return "/kaggle/working/miniimagenet_split"
    elif os.path.isdir("/content"):
        return "/content/miniimagenet_split"
    else:
        return os.path.join(os.getcwd(), "miniimagenet_split")

MINI_ROOT = _default_data_root()
print(f"📂 Data root: {MINI_ROOT}")


def _find_class_dirs(root):
    """مجلد أبناؤه المباشرين كلهم مجلدات أصناف (≥50 مجلد، فيهم صور)."""
    for r, dirs, files in os.walk(root):
        sub_dirs = [d for d in dirs if os.path.isdir(os.path.join(r, d))]
        if len(sub_dirs) < 50:
            continue
        sample = os.path.join(r, sub_dirs[0])
        if any(f.lower().endswith(("jpg", "jpeg", "png")) for f in os.listdir(sample)):
            return r
    return None


SPLIT_MARKER = os.path.join(MINI_ROOT, ".split_v2_same_as_main")


def prepare_miniimagenet():
    """🆕 نفس منطق الـ split في السكريبت الأساسي بالظبط:
    (1) لو الداتاست فيه train/val/test رسمي → بيستخدمه.
    (2) غير كده: split عشوائي 64/16/20 بـ random.Random(42) (مش random.shuffle العام).
    ده بيخلّي أرقام الـ sweep قابلة للمقارنة مع تجارب 84/224 الأساسية."""
    if os.path.exists(MINI_ROOT):
        if not os.path.exists(SPLIT_MARKER):
            print("⚠️  مجلد الـ split موجود وبدون علامة التوافق. لو اتبنى بالنسخة القديمة من "
                  "السكريبت ده (random.shuffle) فالـ split مختلف عن التجارب الأساسية — "
                  f"امسح {MINI_ROOT} وشغّل تاني. لو جاي من السكريبت الأساسي، تجاهل التحذير.")
        else:
            print("✅ miniImageNet split already present (same split as main experiments).")
        return

    print("\n📥 Downloading miniImageNet...")
    try:
        dataset_path = kagglehub.dataset_download("arjunashok33/miniimagenet")
        os.makedirs(MINI_ROOT, exist_ok=True)

        existing = {}
        for name in ["train", "val", "test"]:
            for r, dirs, files in os.walk(dataset_path):
                if os.path.basename(r).lower() == name and dirs:
                    existing[name] = r
                    break
        if len(existing) == 3:
            print("📦 Found official train/val/test split folders.")
            for name, src_root in existing.items():
                dst = os.path.join(MINI_ROOT, name)
                if not os.path.exists(dst):
                    shutil.copytree(src_root, dst)
            open(SPLIT_MARKER, "w").close()
            print("✅ miniImageNet ready (official 64/16/20 split)")
            return

        images_root = _find_class_dirs(dataset_path)
        if images_root is None:
            raise RuntimeError("Could not locate miniImageNet class directories.")
        classes = sorted(d for d in os.listdir(images_root)
                         if os.path.isdir(os.path.join(images_root, d)))
        print(f"📦 Found {len(classes)} classes.")
        random.Random(42).shuffle(classes)
        splits = {"train": classes[:64], "val": classes[64:80], "test": classes[80:100]}
        for name, cls_list in splits.items():
            os.makedirs(os.path.join(MINI_ROOT, name), exist_ok=True)
            for c in cls_list:
                dst = os.path.join(MINI_ROOT, name, c)
                if not os.path.exists(dst):
                    shutil.copytree(os.path.join(images_root, c), dst)
        open(SPLIT_MARKER, "w").close()
        print("✅ miniImageNet ready (random 64/16/20, Random(42))")
    except Exception as e:
        print(f"❌ Error downloading/preparing miniImageNet: {e}")
        raise


with StageTimer("Stage 0: Data Preparation (miniImageNet)"):
    prepare_miniimagenet()

# ============================================
# 4. RESOLUTION SWEEP CONFIGURATION
# ============================================
# 5 دقات صورة. نسبة هامش الـ crop ثابتة (~12.5%) عبر كل الدقات
# (resize_dim = crop_dim × 256/224 ≈ 1.143)، بنفس النسبة المستخدمة في
# باقي سكريباتنا لـ224×224 — عشان شدة الـ augmentation تفضل متساوية.

RESOLUTIONS = [84, 112, 168, 224, 256]

def get_resize_dim(crop_dim):
    return round(crop_dim * 256 / 224)


def build_transforms(resolution):
    """نفس دالة build_transforms في باقي سكريباتنا، بس هنا بتشتغل مع أي
    دقة من الـ 5 (مش بس 84/224)."""
    resize_dim = get_resize_dim(resolution)

    train_transform = transforms.Compose([
        transforms.Resize((resize_dim, resize_dim)),
        transforms.RandomCrop(resolution),
        transforms.RandomHorizontalFlip(),
        transforms.ColorJitter(0.4, 0.4, 0.4),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])
    test_transform = transforms.Compose([
        transforms.Resize((resize_dim, resize_dim)),
        transforms.CenterCrop(resolution),
        transforms.ToTensor(),
        transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])
    ])
    return train_transform, test_transform

# ============================================
# 5. MODEL: MOBILENETV3-SMALL + PLAIN PROTONET
# ============================================

def get_mobilenet_finetuned(num_classes=64, supervised=True):
    """MobileNetV3-Small (ImageNet pretrained) — نفس دالة get_mobilenet_finetuned
    في السكريبت الأصلي بتاعنا."""
    print(f"🔄 Loading MobileNetV3-SMALL (num_classes={num_classes})...")
    weights = models.MobileNet_V3_Small_Weights.DEFAULT
    model = models.mobilenet_v3_small(weights=weights)
    if supervised:
        in_features = model.classifier[3].in_features
        model.classifier[3] = nn.Linear(in_features, num_classes)
    else:
        model.classifier = nn.Identity()
    return model


def compute_prototype(z_support):
    """البروتوتايب = متوسط سمات الدعم الخام (بدون أي normalize ثابت)."""
    return z_support.mean(dim=0)


class MobileProtoNet(nn.Module):
    """
    Plain ProtoNet — مطابق تمامًا لـ ResNetProtoNet في باقي سكريباتنا:
    بدون LearnableNorm، بدون gamma، وبدون حتى L2-normalize ثابت على
    الـ embeddings (مش موجود في نسختنا الأصلية). البروتوتايب = متوسط
    سمات الدعم، والـ logits = -مربع المسافة الإقليدية.
    """
    def __init__(self, backbone):
        super().__init__()
        self.backbone = backbone

    def forward(self, support_x, query_x, n_way, k_shot):
        x = torch.cat([support_x, query_x], dim=0)
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        z = torch.flatten(x, 1)

        z_support = z[:support_x.size(0)]
        z_query   = z[support_x.size(0):]

        z_proto = torch.stack([
            compute_prototype(z_support[i * k_shot:(i + 1) * k_shot])
            for i in range(n_way)
        ])

        dists = torch.cdist(z_query, z_proto) ** 2
        return -dists

# ============================================
# 6. EPISODIC SAMPLER (نفس سكريباتنا بالظبط)
# ============================================

class EpisodicSampler:
    def __init__(self, root, transform):
        self.root      = root
        self.transform = transform
        self.classes   = sorted(os.listdir(root))
        self.data      = {}
        for c in self.classes:
            cls_path = os.path.join(root, c)
            self.data[c] = [
                os.path.join(cls_path, img)
                for img in os.listdir(cls_path)
                if img.lower().endswith(("jpg", "jpeg", "png"))
            ]

    def get_episode(self, n_way, k_shot, q_query):
        selected_classes = random.sample(self.classes, n_way)
        support_imgs, query_imgs, query_labels = [], [], []
        for i, cls in enumerate(selected_classes):
            available_imgs = self.data[cls]
            needed = k_shot + q_query
            sampled_paths = (random.choices(available_imgs, k=needed)
                              if len(available_imgs) < needed
                              else random.sample(available_imgs, needed))
            for p in sampled_paths[:k_shot]:
                support_imgs.append(self.transform(Image.open(p).convert("RGB")))
            for p in sampled_paths[k_shot:]:
                query_imgs.append(self.transform(Image.open(p).convert("RGB")))
                query_labels.append(i)
        return (torch.stack(support_imgs), torch.stack(query_imgs), torch.tensor(query_labels))

# ============================================
# 7. EXECUTION STAGES
# ============================================

# batch size أقل عند الدقات الكبيرة عشان نتجنب overflow في VRAM (T4 16GB) — وضع per_resolution
BATCH_SIZE_BY_RESOLUTION = {84: 64, 112: 48, 168: 32, 224: 32, 256: 16}

# 🆕 وضع حجم الدفعة (علشان نفصل أثر الدقة عن أثر حجم الدفعة — اعتراض الـ reviewer):
#   "per_resolution" : زي الأصلي (64/48/32/32/16 حسب الدقة) → حجم الدفعة متداخل مع الدقة.
#   "fixed"          : حجم دفعة واحد لكل الدقات (FIXED_BATCH_SIZE) → الدقة هي المتغيّر الوحيد.
# شغّل السكريبت مرتين (مرة لكل وضع) وقارن. الملفات والنتايج بتتفصل تلقائيًا باسم الوضع.
BATCH_MODE       = "per_resolution"   # أو "fixed"
FIXED_BATCH_SIZE = 16                 # أكبر قيمة بتشتغل عند 256 على T4 (16GB)
assert BATCH_MODE in ("per_resolution", "fixed")
RUN_TAG = "bsfixed%d" % FIXED_BATCH_SIZE if BATCH_MODE == "fixed" else "bsperres"

def get_batch_size(resolution):
    if BATCH_MODE == "fixed":
        return FIXED_BATCH_SIZE
    return BATCH_SIZE_BY_RESOLUTION.get(resolution, 32)

print(f"🧮 BATCH_MODE={BATCH_MODE} | batch sizes: "
      f"{ {r: get_batch_size(r) for r in RESOLUTIONS} }")


# ============================================
# 7a. WORK DIR + GITHUB AUTO-PUSH / AUTO-RESTORE
# ============================================
# كل ملفات الـ sweep (progress + checkpoints + results) جوه WORK_ROOT. بعد كل دقة
# بتخلص بيتعمل push تلقائي لـ GitHub، ولما تشغّل تاني بيرجّع آخر نسخة من GitHub
# ويكمّل من عند آخر حاجة خلصت. مطلوب: Internet On + Secret اسمه GITHUB_TOKEN
# (Kaggle: Add-ons → Secrets | Colab: Secrets في الشريط الجانبي | أو متغيّر بيئة GITHUB_TOKEN).
import glob, subprocess

GITHUB_REPO      = "Ahmed-Hamam/miniimagenet-small-scratch-results"   # ⚠️ غيّرها: username/reponame
GITHUB_BRANCH    = "main"
GITHUB_SUBFOLDER = f"miniimagenet_small_sweep_{RUN_TAG}"       # منفصل لكل BATCH_MODE
GITHUB_CLONE_DIR = os.path.join(os.path.dirname(MINI_ROOT), "_github_sweep_repo")
GITHUB_MAX_FILE_MB = 95

WORK_ROOT = os.path.join(os.path.dirname(MINI_ROOT), f"miniimagenet_small_sweep_workdir_{RUN_TAG}")
os.makedirs(WORK_ROOT, exist_ok=True)
print(f"📂 WORK_ROOT = {WORK_ROOT}")


def _git(args, cwd=None):
    r = subprocess.run(["git"] + args, cwd=cwd, capture_output=True, text=True,
                       env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    return r.returncode == 0, (r.stdout + r.stderr).strip()


def _github_remote_url():
    """يرجّع remote URL فيه التوكن، أو None (مع طباعة السبب) لو مش متاح."""
    if GITHUB_REPO.startswith("your-username/"):
        print("ℹ️  GITHUB_REPO لسه على القيمة الافتراضية — الـ push/restore على GitHub متعطّل.")
        return None
    token = os.environ.get("GITHUB_TOKEN")
    if not token:
        try:
            from kaggle_secrets import UserSecretsClient
            token = UserSecretsClient().get_secret("GITHUB_TOKEN")
        except Exception:
            try:
                from google.colab import userdata
                token = userdata.get("GITHUB_TOKEN")
            except Exception:
                token = None
    if not token:
        print("⚠️  مقدرتش أجيب GITHUB_TOKEN (Secret أو متغيّر بيئة) — GitHub متعطّل.")
        return None
    return f"https://x-access-token:{token}@github.com/{GITHUB_REPO}.git"


def restore_from_github():
    """لو WORK_ROOT فاضي من progress → ينزّل آخر نسخة من GitHub (progress + checkpoints)."""
    if glob.glob(os.path.join(WORK_ROOT, "resolution_sweep_progress_*.json")):
        print("✅ progress موجود محليًا — مفيش حاجة نسترجعها من GitHub.")
        return
    url = _github_remote_url()
    if not url:
        return
    print(f"\n🔍 بحاول أسترجع نسخة سابقة من GitHub ({GITHUB_REPO}/{GITHUB_SUBFOLDER})...")
    import shutil as _sh
    _sh.rmtree(GITHUB_CLONE_DIR, ignore_errors=True)
    ok, out = _git(["clone", "--depth", "1", "--branch", GITHUB_BRANCH, url, GITHUB_CLONE_DIR])
    if not ok:
        print("ℹ️  مقدرتش أعمل clone (مستودع فاضي/اسم غلط؟) — هبدأ من الصفر.")
        _sh.rmtree(GITHUB_CLONE_DIR, ignore_errors=True)
        return
    src = os.path.join(GITHUB_CLONE_DIR, GITHUB_SUBFOLDER)
    n = 0
    if os.path.isdir(src):
        for f in os.listdir(src):
            sp, dp = os.path.join(src, f), os.path.join(WORK_ROOT, f)
            if os.path.isfile(sp) and not os.path.exists(dp):
                _sh.copy2(sp, dp); n += 1
    print(f"♻️  اتسترجع {n} ملف من GitHub." if n else "ℹ️  مفيش نسخة سابقة في المستودع — هبدأ من الصفر.")
    _sh.rmtree(GITHUB_CLONE_DIR, ignore_errors=True)   # الـ remote فيه التوكن


def push_to_github(msg):
    """بيرفع كل محتوى WORK_ROOT لمجلد GITHUB_SUBFOLDER. أي فشل = تحذير بس (التدريب بيكمّل)."""
    try:
        url = _github_remote_url()
        if not url:
            return False
        import shutil as _sh
        _sh.rmtree(GITHUB_CLONE_DIR, ignore_errors=True)
        ok, _ = _git(["clone", "--depth", "1", "--branch", GITHUB_BRANCH, url, GITHUB_CLONE_DIR])
        if not ok:
            os.makedirs(GITHUB_CLONE_DIR, exist_ok=True)
            _git(["init"], GITHUB_CLONE_DIR)
            _git(["checkout", "-b", GITHUB_BRANCH], GITHUB_CLONE_DIR)
            _git(["remote", "add", "origin", url], GITHUB_CLONE_DIR)
        _git(["config", "user.email", "sweep-bot@example.com"], GITHUB_CLONE_DIR)
        _git(["config", "user.name", "Sweep Auto-Push"], GITHUB_CLONE_DIR)
        dst = os.path.join(GITHUB_CLONE_DIR, GITHUB_SUBFOLDER)
        os.makedirs(dst, exist_ok=True)
        for f in os.listdir(WORK_ROOT):
            p = os.path.join(WORK_ROOT, f)
            if not os.path.isfile(p) or f.endswith(".tmp"):
                continue
            if os.path.getsize(p) / 2**20 > GITHUB_MAX_FILE_MB:
                print(f"⚠️  اتخطّيت {f} (أكبر من {GITHUB_MAX_FILE_MB}MB)")
                continue
            _sh.copy2(p, os.path.join(dst, f))
        _git(["add", "-A"], GITHUB_CLONE_DIR)
        ok, out = _git(["commit", "-m", msg], GITHUB_CLONE_DIR)
        if not ok and "nothing to commit" not in out.lower():
            print(f"⚠️  git commit فشل: {out[:200]}")
            return False
        ok, out = _git(["push", "-u", "origin", f"HEAD:{GITHUB_BRANCH}"], GITHUB_CLONE_DIR)
        _sh.rmtree(GITHUB_CLONE_DIR, ignore_errors=True)
        if not ok:
            print("⚠️  git push فشل (التدريب هيكمّل، الملفات لسه محلية). تأكد من اسم المستودع وصلاحيات التوكن.")
            return False
        print(f"🚀 push ناجح → {GITHUB_REPO}/{GITHUB_SUBFOLDER} ({msg})")
        return True
    except Exception as e:
        print(f"⚠️  GitHub push فشل بشكل غير متوقع ({e}) — بكمّل عادي.")
        return False

def stage1_finetuning(resolution, save_path, epochs=10, num_classes=64):
    """
    Stage 1: fine-tuning عند دقة معيّنة. نفس hyperparameters سكريباتنا
    الأصلية (SGD lr=0.01, momentum=0.9, wd=1e-4, CosineAnnealingLR)
    بما إن الـ backbone هنا MobileNetV3-Small مُدرَّب مسبقًا على ImageNet
    (مش تدريب من الصفر زي حالة ResNet-12).
    """
    print(f"\n🦾 STAGE 1: Fine-tuning @ {resolution}×{resolution} → {save_path}")

    train_transform, _ = build_transforms(resolution)
    train_dataset = datasets.ImageFolder(
        os.path.join(MINI_ROOT, "train"), transform=train_transform
    )
    batch_size = get_batch_size(resolution)
    train_loader = DataLoader(train_dataset, batch_size=batch_size, shuffle=True,
                               num_workers=2, pin_memory=True)
    print(f"   Batch size: {batch_size}")

    model = get_mobilenet_finetuned(num_classes=num_classes, supervised=True).to(device)
    optimizer = torch.optim.SGD(model.parameters(), lr=0.01, momentum=0.9,
                                 nesterov=True, weight_decay=1e-4)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
    criterion = nn.CrossEntropyLoss()

    for epoch in range(epochs):
        model.train()
        total_loss, correct, total = 0, 0, 0
        pbar = tqdm(train_loader, desc=f"   Fine-tune Ep {epoch+1}", leave=False)
        for imgs, labels in pbar:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(imgs)
            loss = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            correct += (outputs.argmax(1) == labels).sum().item()
            total += labels.size(0)
            pbar.set_postfix({"Acc": f"{correct/total:.1%}"})
        scheduler.step()
        print(f"   Ep {epoch+1}: Loss {total_loss/len(train_loader):.4f} | "
              f"Train Acc {correct/total:.2%}")

    torch.save(model.state_dict(), save_path)
    print(f"✅ Fine-tuning Complete. Saved → {save_path}")


def stage2_metatrain(resolution, pretrained_path, n_way=5, k_shot=1,
                      episodes=1000, num_classes=64, save_path=None):
    """
    Stage 2: meta-training عند نفس الدقة. نفس curriculum سكريباتنا
    (Adam lr=1e-5, q_query=15, val كل 200 episode، patience=10).
    """
    print(f"\n🧠 STAGE 2: Meta-Training @ {resolution}×{resolution} "
          f"({n_way}-way {k_shot}-shot)")

    base_model = get_mobilenet_finetuned(num_classes=num_classes, supervised=True)
    base_model.load_state_dict(torch.load(pretrained_path, map_location=device))
    base_model.classifier = nn.Identity()
    model = MobileProtoNet(base_model).to(device)

    _, test_transform = build_transforms(resolution)
    train_sampler = EpisodicSampler(os.path.join(MINI_ROOT, "train"), test_transform)
    val_sampler   = EpisodicSampler(os.path.join(MINI_ROOT, "val"),   test_transform)

    optimizer = torch.optim.Adam(model.backbone.parameters(), lr=1e-5)
    criterion = nn.CrossEntropyLoss()

    best_val_acc = 0.0
    patience = 0

    for ep in tqdm(range(episodes), desc=f"   Meta-Train {resolution}px"):
        sx, qx, qy = train_sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        model.train()
        optimizer.zero_grad()
        loss = criterion(model(sx, qx, n_way, k_shot), qy)
        loss.backward()
        optimizer.step()

        if (ep + 1) % 200 == 0:
            val_acc, _ = evaluate(model, val_sampler, n_way, k_shot,
                                   episodes=200, silent=True)
            print(f"\n   Ep {ep+1}: Loss {loss.item():.4f} | Val Acc {val_acc:.2%}")
            if val_acc > best_val_acc:
                best_val_acc = val_acc
                if save_path:
                    torch.save(model.state_dict(), save_path)
                patience = 0
            else:
                patience += 1
                if patience > 10:
                    print("⏹️ Early stopping triggered.")
                    break

    print(f"   Best val: {best_val_acc:.2%}")


@torch.no_grad()
def evaluate(model, sampler, n_way, k_shot, episodes=500, silent=False):
    model.eval()
    accs = []
    iterator = range(episodes) if silent else tqdm(range(episodes), desc="   Evaluating")
    for _ in iterator:
        sx, qx, qy = sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)
        preds = model(sx, qx, n_way, k_shot).argmax(1)
        accs.append((preds == qy).float().mean().item())
    mean_acc = np.mean(accs)
    ci95 = 1.96 * np.std(accs) / np.sqrt(episodes)
    if not silent:
        print(f"📊 Result: {mean_acc:.2%} ± {ci95:.2%}")
    return mean_acc, ci95


def load_model_for_eval(ckpt_path, num_classes=64):
    base_model = get_mobilenet_finetuned(num_classes=num_classes, supervised=True)
    base_model.classifier = nn.Identity()
    model = MobileProtoNet(base_model)
    model.load_state_dict(torch.load(ckpt_path, map_location=device))
    return model.to(device).eval()

