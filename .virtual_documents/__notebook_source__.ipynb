# 6. EXECUTION STAGES
# ============================================

def stage1_finetuning(epochs_frozen=10, epochs_full=40):
    """
    Two-phase fine-tuning optimised for 84×84 MiniImageNet.

    Phase 1 — frozen backbone (10 ep):
      Train only the new classifier head with Adam lr=1e-3.
      Warms up the head weights before touching the pretrained features.

    Phase 2 — full fine-tune (40 ep):
      Unfreeze all layers with layer-wise SGD learning rates:
        early layers  lr=1e-4  (stable pretrained features)
        late  layers  lr=5e-4  (more task-adaptive)
        head          lr=1e-2  (new, needs fastest update)
      + label smoothing, Mixup augmentation, gradient clipping.
    """
    print(f"\n{'='*60}")
    print(f"🦾 STAGE 1: Fine-tune MobileNetV3-Small at {IMG_SIZE}×{IMG_SIZE}")
    print(f"   Phase 1 (frozen features): {epochs_frozen} ep")
    print(f"   Phase 2 (full fine-tune):  {epochs_full} ep")
    print(f"{'='*60}")

    criterion = nn.CrossEntropyLoss(label_smoothing=0.1)

    # ── Load pretrained backbone ─────────────────────────────
    model = models.mobilenet_v3_small(weights=None)
    state = torch.hub.load_state_dict_from_url(
        "https://download.pytorch.org/models/mobilenet_v3_small-047dcff4.pth",
        map_location=device,
    )
    model.load_state_dict(state)

    # Replace classifier head for 64 training classes
    in_f = model.classifier[3].in_features
    model.classifier[3] = nn.Linear(in_f, 64)
    nn.init.kaiming_normal_(model.classifier[3].weight)
    nn.init.zeros_(model.classifier[3].bias)
    model = model.to(device)

    # ════════════════════════════════════════════════════════
    # PHASE 1 — frozen backbone, train head only
    # ════════════════════════════════════════════════════════
    print("\n📌 Phase 1: head-only training (backbone frozen)")
    for p in model.features.parameters():
        p.requires_grad = False

    optimizer = torch.optim.Adam(
        filter(lambda p: p.requires_grad, model.parameters()), lr=1e-3
    )
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=epochs_frozen, eta_min=1e-5
    )

    for epoch in range(epochs_frozen):
        model.train()
        total_loss, correct, total = 0.0, 0, 0
        pbar = tqdm(train_loader_simple,
                    desc=f"Ph1 Ep {epoch+1:02d}/{epochs_frozen}", leave=False)
        for imgs, labels in pbar:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            out  = model(imgs)
            loss = criterion(out, labels)
            loss.backward()
            optimizer.step()
            total_loss += loss.item()
            correct    += (out.argmax(1) == labels).sum().item()
            total      += labels.size(0)
            pbar.set_postfix(Acc=f"{correct/total:.1%}")
        scheduler.step()
        print(f"  Ph1 Ep {epoch+1:02d}: loss={total_loss/len(train_loader_simple):.4f}  "
              f"acc={correct/total:.2%}  lr={scheduler.get_last_lr()[0]:.2e}")

    # ════════════════════════════════════════════════════════
    # PHASE 2 — unfreeze all, layer-wise LR + Mixup
    # ════════════════════════════════════════════════════════
    print("\n🔓 Phase 2: full fine-tune (layer-wise LR + Mixup)")
    for p in model.features.parameters():
        p.requires_grad = True

    # Layer-wise learning rates — lower for early (stable) layers
    early_params = list(model.features[:5].parameters())
    late_params  = list(model.features[5:].parameters())
    head_params  = list(model.classifier.parameters())

    optimizer = torch.optim.SGD([
        {"params": early_params, "lr": 1e-4},   # pretrained early layers
        {"params": late_params,  "lr": 5e-4},   # pretrained late layers
        {"params": head_params,  "lr": 1e-2},   # new head — learns fast
    ], momentum=0.9, weight_decay=1e-4, nesterov=True)

    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=epochs_full, eta_min=1e-6
    )

    best_acc   = 0.0
    best_path  = "backbone_best.pth"

    for epoch in range(epochs_full):
        model.train()
        total_loss, correct, total = 0.0, 0, 0
        pbar = tqdm(train_loader_simple,
                    desc=f"Ph2 Ep {epoch+1:02d}/{epochs_full}", leave=False)

        for imgs, labels in pbar:
            imgs, labels = imgs.to(device), labels.to(device)

            # Mixup augmentation
            lam   = np.random.beta(0.4, 0.4)
            idx   = torch.randperm(imgs.size(0), device=device)
            mixed = lam * imgs + (1 - lam) * imgs[idx]

            optimizer.zero_grad()
            out  = model(mixed)
            loss = lam * criterion(out, labels) + (1 - lam) * criterion(out, labels[idx])
            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)
            optimizer.step()

            total_loss += loss.item()
            correct    += (out.argmax(1) == labels).sum().item()
            total      += labels.size(0)
            pbar.set_postfix(Acc=f"{correct/total:.1%}")

        scheduler.step()
        acc = correct / total
        print(f"  Ph2 Ep {epoch+1:02d}: loss={total_loss/len(train_loader_simple):.4f}  "
              f"acc={acc:.2%}  lr={scheduler.get_last_lr()[0]:.2e}")

        if acc > best_acc:
            best_acc = acc
            torch.save(model.state_dict(), best_path)
            print(f"  💾 New best backbone → {best_path}  ({best_acc:.2%})")

    # Copy best checkpoint to the expected backbone path
    shutil.copy(best_path, BACKBONE_PATH)
    print(f"\n✅ Stage 1 complete.  Best acc: {best_acc:.2%}")
    print(f"   Backbone saved → {BACKBONE_PATH}")
    return model


def stage2_metatrain(pretrained_path, n_way=5, k_shot=1, episodes=1000):
    """Train our full method: LearnableNorm + Dynamic Gating (learnable gamma)."""
    print(f"\n🧠 STAGE 2 [Full Method]: Meta-Training {n_way}-way {k_shot}-shot...")

    base_model = get_mobilenet_finetuned(num_classes=64, supervised=True)
    base_model.load_state_dict(torch.load(pretrained_path, map_location=device))
    base_model.classifier = nn.Identity()

    model = MobileProtoNet(base_model).to(device)

    # Parameter groups — three different learning rates:
    #
    #  backbone      lr=1e-5  — fine-tune slowly (already pretrained)
    #  alpha (norm)  lr=1e-3  — scalar, needs faster update than backbone
    #  gamma_raw     lr=1e-2  — single scalar; needs aggressive lr to
    #                           visibly learn within 1000 episodes.
    #                           100x backbone lr is standard practice
    #                           for task-level scalars in metric learning.
    optimizer = torch.optim.Adam([
        {"params": model.backbone.parameters(),        "lr": 1e-5},
        {"params": model.learnable_norm.parameters(),  "lr": 1e-3},
        {"params": [model.gamma_raw],                  "lr": 1e-2},
    ])
    criterion = nn.CrossEntropyLoss()

    best_val_acc = 0.0
    patience     = 0

    for ep in tqdm(range(episodes), desc="Meta-Train [Full]"):
        sx, qx, qy = train_sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        model.train()
        optimizer.zero_grad()
        logits = model(sx, qx, n_way, k_shot)
        loss   = criterion(logits, qy)
        loss.backward()
        optimizer.step()

        if (ep + 1) % 200 == 0:
            val_acc, _ = evaluate(model, val_sampler, n_way, k_shot,
                                  episodes=200, silent=True)
            alpha_val  = model.learnable_norm.alpha.item()
            gamma_val  = F.softplus(model.gamma_raw).item()   # actual temperature
            print(f"\n   Ep {ep+1}: Loss {loss.item():.4f} | "
                  f"Val Acc: {val_acc:.2%} | α={alpha_val:.4f} | γ(temp)={gamma_val:.4f}")

            if val_acc > best_val_acc:
                best_val_acc = val_acc
                torch.save(model.state_dict(), f"best_mobile_proto_{k_shot}shot.pth")
                patience = 0
            else:
                patience += 1
                if patience > 10:
                    print("⏹️ Early stopping triggered.")
                    break

    return model


def stage2_metatrain_baseline(pretrained_path, n_way=5, k_shot=1, episodes=1000):
    """
    Ablation training: same backbone, same episodes, but standard ProtoNet head.
    No LearnableNorm, no Dynamic Gating.
    Saves to best_mobile_proto_baseline_{k_shot}shot.pth.
    """
    print(f"\n🔬 STAGE 2 [Ablation Baseline]: Meta-Training {n_way}-way {k_shot}-shot...")
    print("   (MobileNetV3-Small + standard ProtoNet, no LearnableNorm, no Dynamic Gating)")

    base_model = get_mobilenet_finetuned(num_classes=64, supervised=True)
    base_model.load_state_dict(torch.load(pretrained_path, map_location=device))
    base_model.classifier = nn.Identity()

    model     = MobileProtoNetBaseline(base_model).to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-5)
    criterion = nn.CrossEntropyLoss()

    best_val_acc = 0.0
    patience     = 0

    for ep in tqdm(range(episodes), desc="Meta-Train [Baseline]"):
        sx, qx, qy = train_sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        model.train()
        optimizer.zero_grad()
        logits = model(sx, qx, n_way, k_shot)
        loss   = criterion(logits, qy)
        loss.backward()
        optimizer.step()

        if (ep + 1) % 200 == 0:
            val_acc, _ = evaluate(model, val_sampler, n_way, k_shot,
                                  episodes=200, silent=True)
            print(f"\n   Ep {ep+1}: Loss {loss.item():.4f} | Val Acc: {val_acc:.2%}")

            if val_acc > best_val_acc:
                best_val_acc = val_acc
                torch.save(model.state_dict(),
                           f"best_mobile_proto_baseline_{k_shot}shot.pth")
                patience = 0
            else:
                patience += 1
                if patience > 10:
                    print("⏹️ Early stopping triggered.")
                    break

    return model


@torch.no_grad()
def evaluate(model, sampler, n_way, k_shot, episodes=500, silent=False):
    model.eval()
    accs     = []
    iterator = range(episodes) if silent else tqdm(range(episodes), desc="Evaluating")

    for _ in iterator:
        sx, qx, qy = sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        logits = model(sx, qx, n_way, k_shot)
        preds  = logits.argmax(dim=1)
        accs.append((preds == qy).float().mean().item())

    mean_acc = np.mean(accs)
    ci95     = 1.96 * np.std(accs) / np.sqrt(episodes)

    if not silent:
        print(f"📊 Result: {mean_acc:.2%} ± {ci95:.2%}")

    return mean_acc, ci95


def print_benchmark_table(results: dict):
    """
    Print a formatted benchmark table.

    results = {
        "method_name": {"1shot": (mean, ci), "5shot": (mean, ci)},
        ...
    }

    The ablation row (MobileNetV3 + Standard ProtoNet) sits between the
    literature baselines and our full method, making the reviewer's
    attribution analysis straightforward:

      backbone gain  = ablation_row - best_prior_same_backbone
      algorithm gain = full_method  - ablation_row
    """
    print("\n" + "="*72)
    print(f"{'Method':<38} {'Backbone':<18} {'1-shot':>8} {'5-shot':>8}")
    print("="*72)

    for name, data in results.items():
        acc1, ci1 = data.get("1shot", (None, None))
        acc5, ci5 = data.get("5shot", (None, None))
        backbone  = data.get("backbone", "")

        col1 = f"{acc1*100:.2f}±{ci1*100:.2f}" if acc1 else "  —   "
        col5 = f"{acc5*100:.2f}±{ci5*100:.2f}" if acc5 else "  —   "

        # Visually separate the ablation row
        if "Ablation" in name:
            print("-"*72)
        print(f"{name:<38} {backbone:<18} {col1:>12} {col5:>12}")
        if "Ablation" in name:
            print("-"*72)

    print("="*72)
    print("* Literature numbers from original papers (reproduced from Table 2).")
    print("  Backbone sizes: Conv-4 ≈ 0.1M params | ResNet-12 ≈ 12M params")
    print("  MobileNetV3-Small ≈ 1.5M params (pretrained on ImageNet-1k)")
    print()
    print("  Attribution analysis:")

    if ("MobileV3 + Standard ProtoNet (Ablation)" in results and
            "Ours (MobileV3 + LearnableNorm + DynGate)" in results):
        abl1, _  = results["MobileV3 + Standard ProtoNet (Ablation)"]["1shot"]
        full1, _ = results["Ours (MobileV3 + LearnableNorm + DynGate)"]["1shot"]
        abl5, _  = results["MobileV3 + Standard ProtoNet (Ablation)"]["5shot"]
        full5, _ = results["Ours (MobileV3 + LearnableNorm + DynGate)"]["5shot"]
        print(f"  1-shot: backbone contributes ~{abl1*100:.1f}%, "
              f"our algorithm adds +{(full1-abl1)*100:.1f}%")
        print(f"  5-shot: backbone contributes ~{abl5*100:.1f}%, "
              f"our algorithm adds +{(full5-abl5)*100:.1f}%")

    print("="*72 + "\n")

