NUM_TRAIN_CLASSES = 64

# ============================================
# 4. PROTOTYPE FUNCTION (standard ProtoNet — no gating/gamma/alpha)
# ============================================

def compute_prototype_standard(z_support):
    """
    Standard ProtoNet prototype: simple mean of support embeddings.
    No LearnableNorm alpha, no distance-weighted gating, no learnable
    gamma temperature — this is the plain ProtoNet baseline arm.
    """
    return z_support.mean(dim=0)

# ============================================
# 5. MODEL DEFINITION — MobileNetV3-Large
# ============================================

def get_mobilenet_large_finetuned(num_classes=NUM_TRAIN_CLASSES, supervised=True):
    print(f"Loading MobileNetV3-Large (num_classes={num_classes})...")
    weights = models.MobileNet_V3_Large_Weights.DEFAULT
    model   = models.mobilenet_v3_large(weights=weights)

    if supervised:
        in_features = model.classifier[3].in_features
        model.classifier[3] = nn.Linear(in_features, num_classes)
    else:
        model.classifier = nn.Identity()

    return model


def build_protonet_for_inference(checkpoint_path, num_classes=NUM_TRAIN_CLASSES):
    base_model = get_mobilenet_large_finetuned(num_classes=num_classes, supervised=True)
    base_model.classifier = nn.Identity()
    model = MobileProtoNetLargeBaseline(base_model)
    model.load_state_dict(torch.load(checkpoint_path, map_location=device))
    model.to(device)
    model.eval()
    print(f"Loaded checkpoint: {checkpoint_path}")
    return model


class MobileProtoNetLargeBaseline(nn.Module):
    """
    Standard ProtoNet + MobileNetV3-Large backbone.
      - Fixed-scale L2 normalization (no LearnableNorm alpha)
      - Simple mean prototype (no gating)
      - No temperature scaling (no learnable gamma) — raw negative
        distance is used directly as logits, exactly like the
        ResNet-18 ablation baseline scripts.
    """
    def __init__(self, backbone):
        super().__init__()
        self.backbone = backbone

    def forward(self, support_x, query_x, n_way, k_shot):
        x = torch.cat([support_x, query_x], dim=0)
        x = self.backbone.features(x)
        x = self.backbone.avgpool(x)
        z = torch.flatten(x, 1)

        z = F.normalize(z, p=2, dim=1)

        z_support = z[:support_x.size(0)]
        z_query   = z[support_x.size(0):]

        z_proto = torch.stack([
            compute_prototype_standard(z_support[i * k_shot:(i + 1) * k_shot])
            for i in range(n_way)
        ])

        return -torch.cdist(z_query, z_proto)

# ============================================
# 6. DATA TRANSFORMS — TWO RESOLUTION VARIANTS
# ============================================

def get_transforms(resolution):
    """
    resolution: 84 or 224
    For 224: Resize 256 -> RandomCrop/CenterCrop 224 (matches the
             original 224x224 script's transform exactly)
    For 84:  Resize directly to 84 (matches the original 84x84
             script's transform exactly — no crop margin was used
             there, so none is introduced here)
    """
    if resolution == 224:
        train_transform = transforms.Compose([
            transforms.Resize((256, 256)),
            transforms.RandomCrop(224),
            transforms.RandomHorizontalFlip(),
            transforms.ColorJitter(0.4, 0.4, 0.4),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406],
                                  std=[0.229, 0.224, 0.225])
        ])
        test_transform = transforms.Compose([
            transforms.Resize((256, 256)),
            transforms.CenterCrop(224),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406],
                                  std=[0.229, 0.224, 0.225])
        ])
    elif resolution == 84:
        train_transform = transforms.Compose([
            transforms.Resize((84, 84)),
            transforms.RandomHorizontalFlip(),
            transforms.ColorJitter(0.4, 0.4, 0.4),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406],
                                  std=[0.229, 0.224, 0.225])
        ])
        test_transform = transforms.Compose([
            transforms.Resize((84, 84)),
            transforms.ToTensor(),
            transforms.Normalize(mean=[0.485, 0.456, 0.406],
                                  std=[0.229, 0.224, 0.225])
        ])
    else:
        raise ValueError("resolution must be 84 or 224")

    return train_transform, test_transform


class EpisodicSampler:
    def __init__(self, root, transform):
        self.root      = root
        self.transform = transform
        self.classes   = sorted(os.listdir(root))
        self.data      = {}
        for c in self.classes:
            cls_path = os.path.join(root, c)
            self.data[c] = [
                os.path.join(cls_path, img)
                for img in os.listdir(cls_path)
                if img.lower().endswith(('jpg', 'jpeg', 'png'))
            ]

    def get_episode(self, n_way, k_shot, q_query):
        selected_classes = random.sample(self.classes, n_way)
        support_imgs, query_imgs, query_labels = [], [], []

        for i, cls in enumerate(selected_classes):
            available_imgs = self.data[cls]
            needed = k_shot + q_query
            if len(available_imgs) < needed:
                sampled_paths = random.choices(available_imgs, k=needed)
            else:
                sampled_paths = random.sample(available_imgs, needed)

            for path in sampled_paths[:k_shot]:
                img = Image.open(path).convert('RGB')
                support_imgs.append(self.transform(img))
            for path in sampled_paths[k_shot:]:
                img = Image.open(path).convert('RGB')
                query_imgs.append(self.transform(img))
                query_labels.append(i)

        return (torch.stack(support_imgs),
                torch.stack(query_imgs),
                torch.tensor(query_labels))

# ============================================
# 7. STAGE 1 — Supervised Fine-Tuning
# ============================================

def stage1_finetuning(train_loader, epochs=10, num_classes=NUM_TRAIN_CLASSES,
                        save_path="backbone_pretrained.pth"):
    print(f"\nSTAGE 1: Fine-tuning MobileNetV3-Large for {epochs} epochs...")

    model     = get_mobilenet_large_finetuned(num_classes=num_classes, supervised=True).to(device)
    optimizer = torch.optim.SGD(model.parameters(), lr=0.01, momentum=0.9,
                                 nesterov=True, weight_decay=1e-4)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)
    criterion = nn.CrossEntropyLoss()

    for epoch in range(epochs):
        model.train()
        total_loss, correct, total = 0, 0, 0

        pbar = tqdm(train_loader, desc=f"Fine-tune Ep {epoch+1}", leave=False)
        for imgs, labels in pbar:
            imgs, labels = imgs.to(device), labels.to(device)
            optimizer.zero_grad()
            outputs = model(imgs)
            loss    = criterion(outputs, labels)
            loss.backward()
            optimizer.step()

            total_loss += loss.item()
            preds    = outputs.argmax(dim=1)
            correct += (preds == labels).sum().item()
            total   += labels.size(0)
            pbar.set_postfix({'Acc': f"{correct/total:.1%}"})

        scheduler.step()
        print(f"   Ep {epoch+1}: Loss {total_loss/len(train_loader):.4f} | "
              f"Train Acc {correct/total:.2%}")

    print("Fine-tuning complete.")
    torch.save(model.state_dict(), save_path)
    return model

# ============================================
# 8. STAGE 2 — Episodic Meta-Training
# ============================================

def stage2_metatrain(pretrained_path, train_sampler, val_sampler,
                       n_way=5, k_shot=1, episodes=2000,
                       num_classes=NUM_TRAIN_CLASSES,
                       save_prefix="best_mobile_proto"):
    """
    Standard ProtoNet meta-training — single Adam param group, lr=1e-5,
    since there is no LearnableNorm alpha or gamma_raw to tune at
    differentiated rates anymore. Matches the ResNet-18 baseline
    scripts' optimizer setup exactly.
    """
    print(f"\nSTAGE 2: Meta-Training (standard ProtoNet) {n_way}-way {k_shot}-shot...")
    print("  (MobileNetV3-Large, no LearnableNorm, no learnable gamma)")

    base_model = get_mobilenet_large_finetuned(num_classes=num_classes, supervised=True)
    base_model.load_state_dict(torch.load(pretrained_path, map_location=device))
    base_model.classifier = nn.Identity()

    model = MobileProtoNetLargeBaseline(base_model).to(device)
    optimizer = torch.optim.Adam(model.parameters(), lr=1e-5)
    criterion = nn.CrossEntropyLoss()

    best_val_acc = 0.0
    patience     = 0
    save_path = f"{save_prefix}_{k_shot}shot.pth"

    for ep in tqdm(range(episodes), desc="Meta-Train"):
        sx, qx, qy = train_sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        model.train()
        optimizer.zero_grad()
        logits = model(sx, qx, n_way, k_shot)
        loss   = criterion(logits, qy)
        loss.backward()
        optimizer.step()

        if (ep + 1) % 200 == 0:
            val_acc, val_ci = evaluate(model, val_sampler, n_way, k_shot,
                                        episodes=200, silent=True)
            print(f"\n   Ep {ep+1}: Loss {loss.item():.4f} | Val Acc: {val_acc:.2%} +/- {val_ci:.2%}")

            if val_acc > best_val_acc:
                best_val_acc = val_acc
                torch.save(model.state_dict(), save_path)
                patience = 0
            else:
                patience += 1
                if patience > 10:
                    print("Early stopping triggered.")
                    break

    print(f"Stage 2 done. Best Val Acc: {best_val_acc:.2%}")
    return model

# ============================================
# 9. EVALUATION
# ============================================

@torch.no_grad()
def evaluate(model, sampler, n_way, k_shot, episodes=500, silent=False):
    model.eval()
    accs     = []
    iterator = range(episodes) if silent else tqdm(range(episodes), desc="Evaluating")

    for _ in iterator:
        sx, qx, qy = sampler.get_episode(n_way, k_shot, q_query=15)
        sx, qx, qy = sx.to(device), qx.to(device), qy.to(device)

        logits = model(sx, qx, n_way, k_shot)
        preds  = logits.argmax(dim=1)
        accs.append((preds == qy).float().mean().item())

    mean_acc = np.mean(accs)
    ci95     = 1.96 * np.std(accs) / np.sqrt(episodes)

    if not silent:
        print(f"Result: {mean_acc:.2%} +/- {ci95:.2%}")

    return mean_acc, ci95

# ============================================
# 10. FULL CONTROLLED RUN — ONE RESOLUTION CONDITION, ONE SEED
# ============================================

def run_resolution_condition(resolution, seed=42, n_way=5, episodes=2000, stage1_epochs=10,
                               num_classes=NUM_TRAIN_CLASSES):
    """
    Stage1 -> Stage2(1-shot) -> Stage2(5-shot) -> Eval -> Efficiency,
    for a single resolution condition (84 or 224) on miniImageNet, at
    a single random seed.

    IMPORTANT: seed affects Stage 1 init/shuffling, episode sampling
    in Stage 2, and the random.sample() calls inside EpisodicSampler.
    It does NOT reshuffle the train/val/test CLASS split itself —
    that split is fixed once by prepare_miniimagenet()'s split_seed=42
    and stays identical across seeds/runs, so that multi-seed variance
    reflects training/sampling stochasticity only, not a different
    class split leaking into the comparison.

    All checkpoint filenames are seed-tagged (e.g. backbone_pretrained_
    84_seed123.pth) so the 3-5 seed runs never overwrite each other and
    can be inspected/reused independently.
    """
    set_seed(seed)

    print("\n" + "=" * 60)
    print(f"  MOBILENETV3-SMALL BASELINE — miniImageNet — {resolution}x{resolution} — seed {seed}")
    print("=" * 60)

    train_t, test_t = get_transforms(resolution)

    train_dataset = datasets.ImageFolder(
        root=os.path.join(MINI_ROOT, "train"), transform=train_t
    )
    train_loader = DataLoader(train_dataset, batch_size=16 if resolution == 224 else 32,
                               shuffle=True, num_workers=2, pin_memory=True)

    train_sampler = EpisodicSampler(os.path.join(MINI_ROOT, "train"), test_t)
    val_sampler   = EpisodicSampler(os.path.join(MINI_ROOT, "val"),   test_t)
    test_sampler  = EpisodicSampler(os.path.join(MINI_ROOT, "test"),  test_t)

    backbone_path = os.path.join(WORK_DIR, f"backbone_large_pretrained_{resolution}_seed{seed}.pth")
    if not os.path.exists(backbone_path):
        with StageTimer(f"Stage 1: Fine-Tuning @ {resolution}x{resolution} (seed {seed})"):
            stage1_finetuning(train_loader, epochs=stage1_epochs,
                               num_classes=num_classes, save_path=backbone_path)
    else:
        print(f"Found {backbone_path}, skipping Stage 1.")

    save_prefix = os.path.join(WORK_DIR, f"best_mobile_large_proto_{resolution}_seed{seed}")

    for k_shot in (1, 5):
        ckpt = f"{save_prefix}_{k_shot}shot.pth"
        if not os.path.exists(ckpt):
            with StageTimer(f"Stage 2: Meta-Train {k_shot}-shot @ {resolution}x{resolution} (seed {seed})"):
                stage2_metatrain(backbone_path, train_sampler, val_sampler,
                                  n_way=n_way, k_shot=k_shot, episodes=episodes,
                                  num_classes=num_classes, save_prefix=save_prefix)
        else:
            print(f"Found {ckpt}, skipping Stage 2 ({k_shot}-shot).")

    model_1shot = build_protonet_for_inference(f"{save_prefix}_1shot.pth", num_classes=num_classes)
    model_5shot = build_protonet_for_inference(f"{save_prefix}_5shot.pth", num_classes=num_classes)

    with StageTimer(f"Stage 3: Final Test Eval @ {resolution}x{resolution} (seed {seed})"):
        print(f"\nFinal test evaluation @ {resolution}x{resolution} (1-shot, seed {seed})...")
        acc1, ci1 = evaluate(model_1shot, test_sampler, n_way=5, k_shot=1, episodes=500)
        print(f"Final test evaluation @ {resolution}x{resolution} (5-shot, seed {seed})...")
        acc5, ci5 = evaluate(model_5shot, test_sampler, n_way=5, k_shot=5, episodes=500)

    efficiency = report_full_efficiency(model_1shot, resolution)

    return {
        "resolution": resolution,
        "seed": seed,
        "1shot": (acc1, ci1),
        "5shot": (acc5, ci5),
        "efficiency": efficiency,
    }


# ============================================
# 10b. MULTI-SEED AGGREGATION — ONE RESOLUTION CONDITION
# ============================================

def run_resolution_condition_multiseed(resolution, seeds=(42, 123, 456, 789, 2024),
                                         n_way=5, episodes=2000, stage1_epochs=10,
                                         num_classes=NUM_TRAIN_CLASSES):
    """
    Repeats run_resolution_condition() across multiple random seeds
    (default: 5 seeds, meeting the "3 to 5 seeds minimum" requirement)
    and aggregates results as mean +/- std across runs, addressing the
    peer-review concern that a single seed cannot distinguish a real
    accuracy gap from run-to-run training variance.

    Reports BOTH:
      - std across seeds of the per-run mean accuracy (the standard
        multi-seed variance figure expected in the paper's ablation
        tables)
      - the original within-run 95% CI (episode-level) is still
        available per seed in each entry of `per_seed_results`, for
        anyone who wants to inspect a single run in isolation.

    Returns a dict with per-seed raw results plus aggregated
    mean/std for 1-shot accuracy, 5-shot accuracy, and each
    efficiency metric (FLOPs/params/latency are near-deterministic
    given a fixed resolution+architecture, but are still aggregated
    for completeness and to catch any measurement noise).
    """
    print("\n" + "#" * 60)
    print(f"# MULTI-SEED RUN — {resolution}x{resolution} — seeds={list(seeds)}")
    print("#" * 60)

    per_seed_results = []
    for seed in seeds:
        result = run_resolution_condition(
            resolution=resolution, seed=seed, n_way=n_way,
            episodes=episodes, stage1_epochs=stage1_epochs,
            num_classes=num_classes
        )
        per_seed_results.append(result)

    acc1_vals = np.array([r["1shot"][0] for r in per_seed_results])
    acc5_vals = np.array([r["5shot"][0] for r in per_seed_results])

    agg = {
        "resolution": resolution,
        "seeds": list(seeds),
        "n_seeds": len(seeds),
        "1shot_mean": float(acc1_vals.mean()),
        "1shot_std": float(acc1_vals.std(ddof=1)) if len(seeds) > 1 else 0.0,
        "1shot_per_seed": acc1_vals.tolist(),
        "5shot_mean": float(acc5_vals.mean()),
        "5shot_std": float(acc5_vals.std(ddof=1)) if len(seeds) > 1 else 0.0,
        "5shot_per_seed": acc5_vals.tolist(),
        "per_seed_results": per_seed_results,
    }

    # Efficiency metrics aggregated the same way, for completeness —
    # these should be near-identical across seeds since they don't
    # depend on training stochasticity, but reporting mean+/-std here
    # still catches any measurement jitter (e.g. latency timing noise).
    for key in ("gflops", "params_M", "mean_latency_ms", "peak_memory_mb"):
        vals = np.array([r["efficiency"][key] for r in per_seed_results
                          if r["efficiency"][key] is not None])
        if len(vals) > 0:
            agg[f"{key}_mean"] = float(vals.mean())
            agg[f"{key}_std"] = float(vals.std(ddof=1)) if len(vals) > 1 else 0.0
        else:
            agg[f"{key}_mean"] = None
            agg[f"{key}_std"] = None

    print(f"\n{'='*60}")
    print(f"MULTI-SEED SUMMARY @ {resolution}x{resolution}  (n={len(seeds)} seeds: {list(seeds)})")
    print(f"{'='*60}")
    print(f"  1-shot: {agg['1shot_mean']:.2%} +/- {agg['1shot_std']:.2%}  "
          f"(per-seed: {[f'{v:.2%}' for v in agg['1shot_per_seed']]})")
    print(f"  5-shot: {agg['5shot_mean']:.2%} +/- {agg['5shot_std']:.2%}  "
          f"(per-seed: {[f'{v:.2%}' for v in agg['5shot_per_seed']]})")
    print(f"{'='*60}")

    return agg

