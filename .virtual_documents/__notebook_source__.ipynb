def find_attached_miniimagenet():
    """
    Kaggle-specific: look for an already-attached miniImageNet dataset
    under /kaggle/input/ (added via the notebook's "Add Input" panel)
    before falling back to a kagglehub download. Attached Kaggle Inputs
    are read-only, already-extracted, and load far faster than any
    download — always prefer them when present.

    Returns the dataset root path if found (a folder directly
    containing ~100 class subfolders), else None.
    """
    if not ON_KAGGLE or not os.path.isdir(INPUT_DIR):
        return None

    for entry in os.listdir(INPUT_DIR):
        candidate = os.path.join(INPUT_DIR, entry)
        if not os.path.isdir(candidate):
            continue
        # Heuristic: miniImageNet class folders are named like
        # "n01532829" (WordNet synset IDs) or similar short codes.
        # Walk up to 2 levels to find a directory containing many
        # (60-100) subdirectories, which is the class-folder layout.
        for root, dirs, files in os.walk(candidate):
            if len(dirs) >= 60:
                return root
            # Don't descend indefinitely into large datasets
            if root.count(os.sep) - candidate.count(os.sep) >= 2:
                dirs[:] = []
    return None


def prepare_miniimagenet(split_seed=42):
    split_root = os.path.join(WORK_DIR, "miniimagenet_split")
    if os.path.exists(split_root):
        print("Data already present.")
        return split_root

    attached_root = find_attached_miniimagenet()
    if attached_root is not None:
        print(f"\nUsing attached Kaggle Input dataset at: {attached_root}")
        dataset_path = attached_root
    else:
        print("\nNo attached Kaggle Input dataset found — falling back to kagglehub download.")
        print("(On Kaggle this requires internet to be enabled in notebook Settings.)")
        try:
            dataset_path = kagglehub.dataset_download("arjunashok33/miniimagenet")
        except Exception as e:
            print(f"Error downloading via kagglehub: {e}")
            print("Fix: attach the miniImageNet dataset via 'Add Input' in the Kaggle "
                  "notebook sidebar, or enable internet access in notebook Settings.")
            return split_root

    print("\nPreparing data splits...")
    classes = sorted([d for d in os.listdir(dataset_path)
                      if os.path.isdir(os.path.join(dataset_path, d))])

    rng = random.Random(split_seed)
    rng.shuffle(classes)

    splits = {
        "train": classes[:64],
        "val":   classes[64:80],
        "test":  classes[80:]
    }

    for split_name, split_classes in splits.items():
        os.makedirs(os.path.join(split_root, split_name), exist_ok=True)
        for c in split_classes:
            src = os.path.join(dataset_path, c)
            dst = os.path.join(split_root, split_name, c)
            if not os.path.exists(dst):
                # Kaggle Inputs are read-only, so always copy (never
                # symlink/move) regardless of source.
                shutil.copytree(src, dst)
    print("Data structure ready.")
    return split_root


