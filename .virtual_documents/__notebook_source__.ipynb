@torch.no_grad()
def benchmark_model(model, sampler, n_way, k_shot, q_query=15,
                     n_warmup=5, n_measure=50, desc=""):
    model.eval()

    for _ in range(n_warmup):
        sx, qx, qy = sampler.get_episode(n_way, k_shot, q_query)
        sx, qx = sx.to(device), qx.to(device)
        _ = model(sx, qx, n_way, k_shot)

    if device == "cuda":
        torch.cuda.synchronize()
        torch.cuda.reset_peak_memory_stats()

    latencies = []
    for _ in tqdm(range(n_measure), desc=f"Benchmark {desc}", leave=False):
        sx, qx, qy = sampler.get_episode(n_way, k_shot, q_query)
        sx, qx = sx.to(device), qx.to(device)

        if device == "cuda":
            torch.cuda.synchronize()
        t0 = time.perf_counter()
        _ = model(sx, qx, n_way, k_shot)
        if device == "cuda":
            torch.cuda.synchronize()
        t1 = time.perf_counter()
        latencies.append((t1 - t0) * 1000.0)

    latencies = np.array(latencies)
    n_queries_per_episode = n_way * q_query
    peak_mem_mb = (torch.cuda.max_memory_allocated() / (1024 ** 2)
                   if device == "cuda" else float('nan'))
    mean_lat = latencies.mean()

    result = {
        "desc": desc,
        "mean_latency_ms": mean_lat,
        "std_latency_ms": latencies.std(),
        "p50_latency_ms": np.percentile(latencies, 50),
        "p95_latency_ms": np.percentile(latencies, 95),
        "peak_gpu_mem_mb": peak_mem_mb,
        "throughput_episodes_per_sec": 1000.0 / mean_lat,
        "throughput_queries_per_sec": (1000.0 / mean_lat) * n_queries_per_episode,
        "n_measure": n_measure,
    }

    print(f"\n⚡ {desc}")
    print(f"   Latency/episode : {mean_lat:.2f} ± {result['std_latency_ms']:.2f} ms "
          f"(p50={result['p50_latency_ms']:.2f}, p95={result['p95_latency_ms']:.2f})")
    print(f"   Peak GPU memory : {peak_mem_mb:.1f} MB")
    print(f"   Throughput      : {result['throughput_episodes_per_sec']:.2f} eps/sec "
          f"| {result['throughput_queries_per_sec']:.1f} queries/sec")
    return result


def run_full_benchmark(ckpts, n_way=5, q_query=15, n_warmup=5, n_measure=50):
    _, test_transform_84  = build_transforms(84)
    _, test_transform_224 = build_transforms(224)
    transforms_by_size = {84: test_transform_84, 224: test_transform_224}

    test_samplers = {
        size: EpisodicSampler(os.path.join(MINI_ROOT, "test"), transforms_by_size[size])
        for size in ckpts.keys()
    }

    bench_results = {}
    for size in sorted(ckpts):
        bench_results[size] = {}
        for seed in sorted(ckpts[size]):
            for k_shot, ckpt_path in sorted(ckpts[size][seed].items()):
                model = build_protonet_for_inference(ckpt_path, num_classes=NUM_TRAIN_CLASSES)
                tag = f"{size}px_seed{seed}_{k_shot}shot"

                res = benchmark_model(
                    model, test_samplers[size],
                    n_way=n_way, k_shot=k_shot, q_query=q_query,
                    n_warmup=n_warmup, n_measure=n_measure, desc=tag
                )
                bench_results[size].setdefault(k_shot, []).append(res)

                del model
                if device == "cuda":
                    torch.cuda.empty_cache()

    print("\n" + "="*60)
    print("📊 BENCHMARK SUMMARY (mean over available seeds)")
    print("="*60)
    for size in sorted(bench_results):
        for k_shot in sorted(bench_results[size]):
            runs = bench_results[size][k_shot]
            n_seeds = len(runs)
            lat_mean = np.mean([r["mean_latency_ms"] for r in runs])
            mem_mean = np.mean([r["peak_gpu_mem_mb"] for r in runs])
            thr_mean = np.mean([r["throughput_episodes_per_sec"] for r in runs])
            print(f"  {size}x{size} | {k_shot}-shot (n_seeds={n_seeds}): "
                  f"Latency={lat_mean:.2f}ms | PeakMem={mem_mean:.1f}MB | "
                  f"Throughput={thr_mean:.2f} eps/sec")

    return bench_results


